model recommendations {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id             String          @db.Uuid
  brand_id                String          @db.Uuid
  is_recommended          Boolean
  recommendation_strength String?         @db.VarChar(50)
  position                Int?
  context                 String?
  confidence              Decimal?        @db.Decimal(3, 2)
  created_at              DateTime        @default(now()) @db.Timestamp(6)
  opportunity_id          String?         @db.Uuid
  gap_id                  String?         @db.Uuid
  rec_type                rec_type?
  title                   String?         @db.VarChar(500)
  rationale               String?
  expected_impact         String?         @db.VarChar(255)
  effort_estimate         effort_estimate @default(medium)
  roi_score               Decimal         @default(0) @db.Decimal(6, 2)
  status                  rec_status      @default(active)
  snoozed_until           DateTime?       @db.Timestamptz(6)
  completed_at            DateTime?       @db.Timestamptz(6)
  updated_at              DateTime        @default(now()) @db.Timestamptz(6)
  analyses                analyses        @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recommendations_analysis_id_analyses_id_fk")
  brands                  brands          @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "recommendations_brand_id_brands_id_fk")
  geo_gaps                geo_gaps?       @relation(fields: [gap_id], references: [id], onUpdate: NoAction)
  opportunities           opportunities?  @relation(fields: [opportunity_id], references: [id], onUpdate: NoAction)

  @@index([brand_id, status, roi_score(sort: Desc)], map: "idx_rec_brand_status")
  @@index([brand_id, rec_type, status], map: "idx_rec_type")
  @@index([analysis_id], map: "idx_recommendations_analysis")
  @@index([brand_id], map: "idx_recommendations_brand")
  @@index([is_recommended], map: "idx_recommendations_is_recommended")
}

