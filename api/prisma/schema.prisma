  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id           String              @db.Uuid
  gap_id             String?             @db.Uuid
  title              String              @db.VarChar(255)
  description        String?
  action_text        String?
  action_type        action_type?
  effort_level       effort_level?
  expected_impact    Decimal?            @db.Decimal(3, 2)
  impact_description String?
  priority_order     Int?
  status             opportunity_status? @default(new)
  evidence           Json?
  created_at         DateTime            @default(now()) @db.Timestamp(6)
  updated_at         DateTime            @default(now()) @db.Timestamp(6)
  keyword_or_query   String?             @db.VarChar(500)
  seo_gap_score      Decimal             @default(0) @db.Decimal(5, 2)
  geo_gap_score      Decimal             @default(0) @db.Decimal(5, 2)
  unified_score      Decimal             @default(0) @db.Decimal(5, 2)
  volume             Int?
  difficulty         Int?                @db.SmallInt
  priority_tier      priority_tier       @default(P3)
  brands             brands              @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "opportunities_brand_id_brands_id_fk")
  gap_analysis       gap_analysis?       @relation(fields: [gap_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "opportunities_gap_id_gap_analysis_id_fk")
  recommendations    recommendations[]
  seo_agent_actions  seo_agent_actions[]

  @@index([brand_id], map: "idx_opportunities_brand")
  @@index([gap_id], map: "idx_opportunities_gap")
  @@index([priority_order], map: "idx_opportunities_priority")
  @@index([status], map: "idx_opportunities_status")
  @@index([brand_id, priority_tier], map: "idx_opportunities_tier")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model org_ai_providers {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  provider_name   String        @db.VarChar(50)
  model           String        @db.VarChar(100)
  api_key_enc     String?
  is_active       Boolean       @default(true)
  priority        Int           @default(1) @db.SmallInt
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prompt_jobs     prompt_jobs[]

  @@unique([organization_id, provider_name])
  @@index([organization_id], map: "idx_org_ai_providers_org")
}

model organizations {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(255)
  slug              String              @unique(map: "organizations_slug_unique") @db.VarChar(255)
  created_by        String              @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @default(now()) @db.Timestamp(6)
  deleted_at        DateTime?           @db.Timestamp(6)
  account_health    account_health?
  actions           actions[]
  ai_usage          ai_usage[]
  audit_events      audit_events[]
  brands            brands[]
  categories        categories[]
  crm_contacts      crm_contacts[]
  crm_notes         crm_notes[]
  geo_agent_runs    geo_agent_runs[]
  growth_agent_runs growth_agent_runs[]
  integrations      integrations[]
  intents           intents[]
  invitations       invitations[]
  memberships       memberships[]
  notifications     notifications[]
  org_ai_providers  org_ai_providers[]
  users             users               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "organizations_created_by_users_id_fk")
  publish_jobs      publish_jobs[]
  seo_agent_runs    seo_agent_runs[]
  snapshot_requests snapshot_requests[]
  subscriptions     subscriptions?
  usage_records     usage_records[]
}

