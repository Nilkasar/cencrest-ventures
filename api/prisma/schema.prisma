  seo_agent_actions       seo_agent_actions[]
  brands                  brands              @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations           organizations       @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token_hash   String   @unique @db.VarChar(255)
  expires_at   DateTime @db.Timestamp(6)
  last_seen_at DateTime @default(now()) @db.Timestamp(6)
  ip_address   String?  @db.VarChar(45)
  user_agent   String?
  created_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expires")
  @@index([token_hash], map: "idx_sessions_token")
  @@index([user_id], map: "idx_sessions_user")
}

model share_of_voice {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id       String         @db.Uuid
  query_id       String         @db.Uuid
  run_id         String         @db.Uuid
  entity_name    String         @db.VarChar(255)
  entity_type    entity_type    @default(brand)
  sov_pct        Decimal        @default(0) @db.Decimal(5, 2)
  mentions       Int            @default(0)
  calculated_at  DateTime       @default(now()) @db.Timestamptz(6)
  brands         brands         @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  buyer_journeys buyer_journeys @relation(fields: [query_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prompt_runs    prompt_runs    @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([query_id, run_id, entity_name])
  @@index([brand_id, run_id], map: "idx_share_of_voice_brand")
}

model snapshot_requests {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain              String          @db.VarChar(255)
  email               String          @db.VarChar(255)
  status              snapshot_status @default(pending)
  result_json         Json?
  ip_address          String?         @db.VarChar(45)
  marketing_consent   Boolean         @default(false)
  converted_to_org_id String?         @db.Uuid
  converted_at        DateTime?       @db.Timestamptz(6)
  expires_at          DateTime        @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  organizations       organizations?  @relation(fields: [converted_to_org_id], references: [id], onUpdate: NoAction)

  @@index([domain, created_at(sort: Desc)], map: "idx_snapshot_domain")
  @@index([email], map: "idx_snapshot_email")
  @@index([ip_address, created_at(sort: Desc)], map: "idx_snapshot_ip")
}

model subscriptions {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String              @unique @db.Uuid
  stripe_customer_id     String?             @unique @db.VarChar(255)
  stripe_subscription_id String?             @unique @db.VarChar(255)
  plan                   String              @default("free") @db.VarChar(50)
  status                 subscription_status @default(active)
  current_period_start   DateTime?           @db.Timestamptz(6)
  current_period_end     DateTime?           @db.Timestamptz(6)
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @default(now()) @db.Timestamptz(6)
  organizations          organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_subscriptions_org")
}

model usage_records {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  metric          usage_metric
  quantity        Int           @default(1)
  recorded_at     DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id, metric, recorded_at], map: "idx_usage_records_org_month")
}

model users {
  id                                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                        String                     @unique(map: "users_email_unique") @db.VarChar(255)
  password_hash                                String                     @db.VarChar(255)
  name                                         String                     @db.VarChar(255)
  email_verified                               Boolean?                   @default(false)
  last_login_at                                DateTime?                  @db.Timestamp(6)
  created_at                                   DateTime                   @default(now()) @db.Timestamp(6)
  updated_at                                   DateTime                   @default(now()) @db.Timestamp(6)
  deleted_at                                   DateTime?                  @db.Timestamp(6)
  actions                                      actions[]
  audit_events                                 audit_events[]
  auth_events                                  auth_events[]
  brands                                       brands[]
  crm_notes                                    crm_notes[]
  invitations                                  invitations[]
  memberships                                  memberships[]
  notification_preferences                     notification_preferences[]
  notifications                                notifications[]
  organizations                                organizations[]
  password_reset_tokens                        password_reset_tokens[]
  publish_jobs_publish_jobs_approved_byTousers publish_jobs[]             @relation("publish_jobs_approved_byTousers")
  publish_jobs_publish_jobs_created_byTousers  publish_jobs[]             @relation("publish_jobs_created_byTousers")
  query_sets                                   query_sets[]
  questions                                    questions[]
  refresh_tokens                               refresh_tokens[]
  reports                                      reports[]
  sessions                                     sessions[]

  @@index([email], map: "idx_users_email")
}

model visibility_scores {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id      String      @db.Uuid
  provider_name String      @db.VarChar(50)
  run_id        String      @db.Uuid
  score         Decimal     @default(0) @db.Decimal(5, 2)
  mention_rate  Decimal     @default(0) @db.Decimal(5, 4)
  avg_sentiment Decimal?    @db.Decimal(4, 3)
  avg_position  Decimal?    @db.Decimal(6, 2)
  calculated_at DateTime    @default(now()) @db.Timestamptz(6)
  brands        brands      @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prompt_runs   prompt_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([brand_id, provider_name, run_id])
  @@index([brand_id, calculated_at(sort: Desc)], map: "idx_visibility_scores_brand")
}

model webhook_deliveries {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration_id String       @db.Uuid
  event_type     String       @db.VarChar(100)
  payload        Json         @default("{}")
  status_code    Int?
  response_body  String?
  attempt        Int          @default(1) @db.SmallInt
  delivered_at   DateTime     @default(now()) @db.Timestamptz(6)
  integrations   integrations @relation(fields: [integration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([integration_id, delivered_at(sort: Desc)], map: "idx_webhook_deliveries_integ")
}

