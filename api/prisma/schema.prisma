generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ai_models {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id     String            @db.Uuid
  name            String            @db.VarChar(100)
  version         String?           @db.VarChar(50)
  capabilities    Json?
  is_active       Boolean?          @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  ai_providers    ai_providers      @relation(fields: [provider_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ai_models_provider_id_ai_providers_id_fk")
  evaluation_runs evaluation_runs[]
  runs            runs[]

  @@index([is_active], map: "idx_ai_models_active")
  @@index([provider_id], map: "idx_ai_models_provider")
}

model ai_providers {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique(map: "ai_providers_name_unique") @db.VarChar(100)
  type       String      @db.VarChar(50)
  config     Json
  is_active  Boolean?    @default(true)
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @default(now()) @db.Timestamp(6)
  ai_models  ai_models[]

  @@index([is_active], map: "idx_ai_providers_active")
  @@index([type], map: "idx_ai_providers_type")
}

model analyses {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id           String                  @db.Uuid
  brand_id              String                  @db.Uuid
  status                run_status
  started_at            DateTime?               @db.Timestamp(6)
  completed_at          DateTime?               @db.Timestamp(6)
  error_message         String?
  metadata              Json?
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  pipeline_version      String?                 @db.VarChar(50)
  model_used            String?                 @db.VarChar(100)
  prompt_used           String?
  brands                brands                  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analyses_brand_id_brands_id_fk")
  responses             responses               @relation(fields: [response_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analyses_response_id_responses_id_fk")
  analysis_findings     analysis_findings[]
  category_associations category_associations[]
  competitor_mentions   competitor_mentions[]
  entities              entities[]
  mentions              mentions[]
  recommendations       recommendations[]

  @@index([brand_id], map: "idx_analyses_brand")
  @@index([response_id], map: "idx_analyses_response")
  @@index([status], map: "idx_analyses_status")
}

model analysis_findings {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id     String       @db.Uuid
  finding_type    finding_type
  entity_name     String?      @db.VarChar(255)
  entity_type     String?      @db.VarChar(50)
  sentiment       sentiment?
  strength        String?      @db.VarChar(50)
  position        Int?
  total_positions Int?
  context         String?
  confidence      Decimal?     @db.Decimal(3, 2)
  metadata        Json?
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  analyses        analyses     @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_findings_analysis_id_analyses_id_fk")

  @@index([analysis_id], map: "idx_analysis_findings_analysis")
  @@index([finding_type], map: "idx_analysis_findings_type")
}

model audiences {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id     String    @db.Uuid
  name         String    @db.VarChar(255)
  description  String?
  demographics Json?
  pain_points  String[]
  goals        String[]
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)
  deleted_at   DateTime? @db.Timestamp(6)
  brands       brands    @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audiences_brand_id_brands_id_fk")

  @@index([brand_id], map: "idx_audiences_brand")
}

model audit_events {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?        @db.Uuid
  organization_id String?        @db.Uuid
  action          String         @db.VarChar(100)
  entity_type     String         @db.VarChar(100)
  entity_id       String         @db.Uuid
  old_value       Json?
  new_value       Json?
  ip_address      String?        @db.VarChar(45)
  user_agent      String?
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_events_organization_id_organizations_id_fk")
  users           users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_events_user_id_users_id_fk")

  @@index([action], map: "idx_audit_events_action")
  @@index([created_at], map: "idx_audit_events_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_events_entity")
  @@index([organization_id], map: "idx_audit_events_organization")
  @@index([user_id], map: "idx_audit_events_user")
}

model auth_events {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  event_type String   @db.VarChar(50)
  ip_address String?  @db.VarChar(45)
  user_agent String?
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([event_type], map: "idx_auth_events_type")
  @@index([user_id], map: "idx_auth_events_user")
}

model background_jobs {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          job_type
  payload       Json
  status        job_status? @default(pending)
  priority      Int?        @default(0)
  attempts      Int?        @default(0)
  max_attempts  Int?        @default(3)
  error_message String?
  started_at    DateTime?   @db.Timestamp(6)
  completed_at  DateTime?   @db.Timestamp(6)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_background_jobs_created_at")
  @@index([priority], map: "idx_background_jobs_priority")
  @@index([status], map: "idx_background_jobs_status")
  @@index([type], map: "idx_background_jobs_type")
}

model brand_aliases {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id   String   @db.Uuid
  alias      String   @db.VarChar(255)
  type       String?  @db.VarChar(50)
  is_primary Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  brands     brands   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brand_aliases_brand_id_brands_id_fk")

  @@index([alias], map: "idx_brand_aliases_alias")
  @@index([brand_id], map: "idx_brand_aliases_brand")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model brand_categories {
  brand_id    String     @db.Uuid
  category_id String     @db.Uuid
  is_primary  Boolean?
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  brands      brands     @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brand_categories_brand_id_brands_id_fk")
  categories  categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brand_categories_category_id_categories_id_fk")

  @@index([brand_id], map: "idx_brand_categories_brand")
  @@index([category_id], map: "idx_brand_categories_category")
  @@ignore
}

model brand_keyword_rankings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id    String   @db.Uuid
  keyword_id  String   @db.Uuid
  position    Int?     @db.SmallInt
  url         String?  @db.VarChar(2048)
  date        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  clicks      Int?
  impressions Int?
  ctr         Decimal? @db.Decimal(5, 4)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  brands      brands   @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  keywords    keywords @relation(fields: [keyword_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([keyword_id, date])
  @@index([brand_id], map: "idx_rankings_brand")
  @@index([keyword_id], map: "idx_rankings_keyword")
}

model brand_services {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id      String    @db.Uuid
  name          String    @db.VarChar(255)
  description   String?
  category      String?   @db.VarChar(100)
  pricing_model String?   @db.VarChar(50)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)
  brands        brands    @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brand_services_brand_id_brands_id_fk")

  @@index([brand_id], map: "idx_brand_services_brand")
}

model brands {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                   @db.Uuid
  name                   String                   @db.VarChar(255)
  description            String?
  website_url            String?                  @db.VarChar(500)
  industry               String?                  @db.VarChar(100)
  logo_url               String?                  @db.VarChar(500)
  created_by             String                   @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at             DateTime?                @db.Timestamp(6)
  aliases                String[]
  positioning            String?
  value_proposition      String?
  key_differentiators    String[]
  analyses               analyses[]
  audiences              audiences[]
  brand_aliases          brand_aliases[]
  brand_categories       brand_categories[]       @ignore
  brand_keyword_rankings brand_keyword_rankings[]
  brand_services         brand_services[]
  users                  users                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brands_created_by_users_id_fk")
  organizations          organizations            @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "brands_organization_id_organizations_id_fk")
  buyer_journeys         buyer_journeys[]
  category_associations  category_associations[]
  competitors            competitors[]
  crawl_jobs             crawl_jobs[]
  gap_analysis           gap_analysis[]
  gsc_connections        gsc_connections?
  keyword_clusters       keyword_clusters[]
  keywords               keywords[]
  measurement_points     measurement_points[]
  mentions               mentions[]
  opportunities          opportunities[]
  pages                  pages[]
  products               products[]
  query_sets             query_sets[]
  questions              questions[]
  recommendations        recommendations[]
  reports                reports[]
  score_history          score_history[]
  scores                 scores[]

  @@index([created_by], map: "idx_brands_creator")
  @@index([industry], map: "idx_brands_industry")
  @@index([organization_id], map: "idx_brands_organization")
}

model buyer_journeys {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id     String             @db.Uuid
  product_id   String?            @db.Uuid
  stage        journey_stage
  persona      String?            @db.VarChar(255)
  query        String
  intent_type  keyword_intent?
  generated_by query_generated_by @default(user)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at   DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?          @db.Timestamptz(6)
  brands       brands             @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products?          @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([brand_id], map: "idx_buyer_journeys_brand")
  @@index([brand_id, stage], map: "idx_buyer_journeys_stage")
}

model categories {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String             @db.Uuid
  name             String             @db.VarChar(255)
  parent_id        String?            @db.Uuid
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  brand_categories brand_categories[] @ignore
  organizations    organizations      @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_organization_id_organizations_id_fk")
  categories       categories?        @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_parent_id_categories_id_fk")
  other_categories categories[]       @relation("categoriesTocategories")

  @@index([organization_id], map: "idx_categories_organization")
  @@index([parent_id], map: "idx_categories_parent")
}

model category_associations {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id      String           @db.Uuid
  brand_id         String           @db.Uuid
  category         String           @db.VarChar(255)
  association_type association_type
  confidence       Decimal?         @db.Decimal(3, 2)
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  analyses         analyses         @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "category_associations_analysis_id_analyses_id_fk")
  brands           brands           @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "category_associations_brand_id_brands_id_fk")

  @@index([analysis_id], map: "idx_category_associations_analysis")
  @@index([brand_id], map: "idx_category_associations_brand")
  @@index([category], map: "idx_category_associations_category")
}

model competitor_mentions {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id   String       @db.Uuid
  competitor_id String       @db.Uuid
  mention_type  mention_type
  sentiment     sentiment?
  position      Int?
  context       String?
  confidence    Decimal?     @db.Decimal(3, 2)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  analyses      analyses     @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "competitor_mentions_analysis_id_analyses_id_fk")
  competitors   competitors  @relation(fields: [competitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "competitor_mentions_competitor_id_competitors_id_fk")

  @@index([analysis_id], map: "idx_competitor_mentions_analysis")
  @@index([competitor_id], map: "idx_competitor_mentions_competitor")
}

model competitors {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id            String                @db.Uuid
  name                String                @db.VarChar(255)
  website_url         String?               @db.VarChar(500)
  description         String?
  competition_type    competition_type?
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  deleted_at          DateTime?             @db.Timestamp(6)
  competitor_mentions competitor_mentions[]
  brands              brands                @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "competitors_brand_id_brands_id_fk")
  gap_analysis        gap_analysis[]

  @@index([brand_id], map: "idx_competitors_brand")
}

model crawl_jobs {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id      String       @db.Uuid
  status        crawl_status @default(pending)
  pages_crawled Int          @default(0)
  pages_found   Int          @default(0)
  error_message String?
  started_at    DateTime?    @db.Timestamptz(6)
  completed_at  DateTime?    @db.Timestamptz(6)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  brands        brands       @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pages         pages[]

  @@index([brand_id], map: "idx_crawl_jobs_brand")
}

model entities {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id     String   @db.Uuid
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(50)
  normalized_name String?  @db.VarChar(255)
  confidence      Decimal? @db.Decimal(3, 2)
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamp(6)
  analyses        analyses @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "entities_analysis_id_analyses_id_fk")

  @@index([analysis_id], map: "idx_entities_analysis")
  @@index([name], map: "idx_entities_name")
}

model evaluation_datasets {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(255)
  description      String?
  category         String             @db.VarChar(50)
  question_count   Int?               @default(0)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  evaluation_items evaluation_items[]
  evaluation_runs  evaluation_runs[]

  @@index([category], map: "idx_evaluation_datasets_category")
}

model evaluation_items {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataset_id          String              @db.Uuid
  input_text          String
  expected_output     Json
  difficulty          String?             @default("medium") @db.VarChar(20)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  evaluation_datasets evaluation_datasets @relation(fields: [dataset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evaluation_items_dataset_id_evaluation_datasets_id_fk")

  @@index([dataset_id], map: "idx_evaluation_items_dataset")
}

model evaluation_runs {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataset_id          String              @db.Uuid
  prompt_version_id   String?             @db.Uuid
  model_id            String?             @db.Uuid
  accuracy            Decimal?            @db.Decimal(5, 2)
  precision_score     Decimal?            @db.Decimal(5, 2)
  recall_score        Decimal?            @db.Decimal(5, 2)
  f1_score            Decimal?            @db.Decimal(5, 2)
  results             Json?
  started_at          DateTime?           @db.Timestamp(6)
  completed_at        DateTime?           @db.Timestamp(6)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  evaluation_datasets evaluation_datasets @relation(fields: [dataset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evaluation_runs_dataset_id_evaluation_datasets_id_fk")
  ai_models           ai_models?          @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evaluation_runs_model_id_ai_models_id_fk")
  prompt_versions     prompt_versions?    @relation(fields: [prompt_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "evaluation_runs_prompt_version_id_prompt_versions_id_fk")

  @@index([dataset_id], map: "idx_evaluation_runs_dataset")
  @@index([model_id], map: "idx_evaluation_runs_model")
  @@index([prompt_version_id], map: "idx_evaluation_runs_prompt_version")
}

model form_submissions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id    String   @db.VarChar(50)
  email      String   @db.VarChar(255)
  payload    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_form_submissions_created")
  @@index([email], map: "idx_form_submissions_email")
  @@index([form_id], map: "idx_form_submissions_form_id")
}

model gap_analysis {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id           String          @db.Uuid
  gap_type           gap_type
  category           String?         @db.VarChar(255)
  intent_id          String?         @db.Uuid
  competitor_id      String?         @db.Uuid
  description        String?
  severity           Decimal?        @db.Decimal(3, 2)
  evidence           Json?
  affected_questions Int?            @default(0)
  detected_at        DateTime?       @db.Timestamp(6)
  status             gap_status?     @default(open)
  created_at         DateTime        @default(now()) @db.Timestamp(6)
  updated_at         DateTime        @default(now()) @db.Timestamp(6)
  brands             brands          @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gap_analysis_brand_id_brands_id_fk")
  competitors        competitors?    @relation(fields: [competitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gap_analysis_competitor_id_competitors_id_fk")
  intents            intents?        @relation(fields: [intent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gap_analysis_intent_id_intents_id_fk")
  opportunities      opportunities[]

  @@index([brand_id], map: "idx_gap_analysis_brand")
  @@index([category], map: "idx_gap_analysis_category")
  @@index([status], map: "idx_gap_analysis_status")
  @@index([gap_type], map: "idx_gap_analysis_type")
}

model gsc_connections {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id          String    @unique @db.Uuid
  site_url          String    @db.VarChar(500)
  access_token_enc  String
  refresh_token_enc String
  token_expires_at  DateTime? @db.Timestamptz(6)
  last_imported_at  DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  brands            brands    @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model intents {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String           @db.Uuid
  name            String           @db.VarChar(255)
  description     String?
  category        intent_category?
  examples        String[]
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @default(now()) @db.Timestamp(6)
  deleted_at      DateTime?        @db.Timestamp(6)
  gap_analysis    gap_analysis[]
  organizations   organizations    @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "intents_organization_id_organizations_id_fk")
  questions       questions[]

  @@index([category], map: "idx_intents_category")
  @@index([organization_id], map: "idx_intents_organization")
}

model invitations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  invited_by      String        @db.Uuid
  email           String        @db.VarChar(255)
  role            role          @default(member)
  token_hash      String        @unique @db.VarChar(255)
  expires_at      DateTime      @db.Timestamp(6)
  accepted_at     DateTime?     @db.Timestamp(6)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  users           users         @relation(fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
