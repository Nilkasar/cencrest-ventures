# BeBest — Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env.local or .env to git

# =============================================================
# DATABASE (PostgreSQL 16 — local dev)
# =============================================================
# Local dev uses PostgreSQL 16 on port 5434 (separate from system PG)
# Data dir: /Users/nilesh/bebest-pgdata
# Start: brew services start postgresql@16 OR pg_ctl -D /Users/nilesh/bebest-pgdata -p 5434 start
DATABASE_URL=postgresql://nilesh@localhost:5434/bebest
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=bebest
DATABASE_USER=nilesh
DATABASE_PASSWORD=

# =============================================================
# OLLAMA (local AI — no API key needed)
# =============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b

# =============================================================
# AI PROVIDERS (set only what you have access to)
# These are OPTIONAL for local dev — Ollama is the default
# =============================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...

# =============================================================
# AUTH (Epic 3 — not yet implemented)
# =============================================================
# JWT_SECRET=generate-with: openssl rand -base64 32
# SESSION_SECRET=generate-with: openssl rand -base64 32

# =============================================================
# EMAIL (Epic 2 — not yet implemented)
# =============================================================
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@bebestwith.ai

# =============================================================
# APP
# =============================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# =============================================================
# FORM BACKEND (D-O10 — currently loses leads, fix urgently)
# =============================================================
# AIRTABLE_API_KEY=...
# AIRTABLE_BASE_ID=...
# AIRTABLE_TABLE_NAME=Leads
