# BeBest — Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env.local or .env to git

# =============================================================
# DATABASE (PostgreSQL 16 — local dev)
# =============================================================
# Local dev uses PostgreSQL 16 on port 5434 (separate from system PG)
# Data dir: /Users/nilesh/bebest-pgdata
# Start: brew services start postgresql@16 OR pg_ctl -D /Users/nilesh/bebest-pgdata -p 5434 start
DATABASE_URL=postgresql://nilesh@localhost:5434/bebest
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=bebest
DATABASE_USER=nilesh
DATABASE_PASSWORD=

# =============================================================
# OLLAMA (local AI — no API key needed)
# =============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b

# =============================================================
# AI PROVIDERS (set only what you have access to)
# These are OPTIONAL for local dev — Ollama is the default
# =============================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...

# =============================================================
# AUTH (Epic 3 — not yet implemented)
# =============================================================
# JWT_SECRET=generate-with: openssl rand -base64 32
# SESSION_SECRET=generate-with: openssl rand -base64 32

# =============================================================
# EMAIL (Resend — ADR-010)
# =============================================================
# Set RESEND_API_KEY and apps/api switches from ConsoleEmailSender
# (log-only) to ResendEmailSender. Unset = dev/CI behaviour, unchanged.
# The EMAIL_FROM domain MUST be verified in Resend or every send fails.
# Default when unset: "BeBest <hello@bebestwithai.com>".
# RESEND_API_KEY=
# EMAIL_FROM=

# =============================================================
# BILLING (Stripe)
# =============================================================
# Set STRIPE_SECRET_KEY and apps/api switches from NullPaymentProvider
# to StripeProvider. Unset = NullPaymentProvider, unchanged.
# STRIPE_WEBHOOK_SECRET is the endpoint signing secret from the Stripe
# dashboard (Developers -> Webhooks); BILLING_WEBHOOK_SECRET is honoured
# as a fallback for the provider-agnostic HMAC path.
# Prices are NOT configured here: create one recurring Stripe Price per
# paid tier with lookup_key set to the plan slug (starter, growth, pro,
# agency, managed, enterprise). 'free' needs no Price.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_WEBHOOK_SECRET=

# =============================================================
# APP
# =============================================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# =============================================================
# FORM BACKEND (D-O10 — currently loses leads, fix urgently)
# =============================================================
# AIRTABLE_API_KEY=...
# AIRTABLE_BASE_ID=...
# AIRTABLE_TABLE_NAME=Leads
