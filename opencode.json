{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (reasoning + planning)",
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B (implementation)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "deepseek-coder:6.7b": {
          "name": "DeepSeek Coder 6.7B (fallback)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B (general)",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  }
}
