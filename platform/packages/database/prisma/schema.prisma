  status              snapshot_status @default(pending)
  result_json         Json?
  ip_address          String?         @db.Inet
  marketing_consent   Boolean         @default(false)
  converted_to_org_id String?         @db.Uuid
  converted_at        DateTime?       @db.Timestamptz(6)
  expires_at          DateTime        @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)

  // Epic 17 (Free AI + SEO Growth Snapshot) addition. `GET /snapshot/:token`
  // is a public, unauthenticated endpoint (docs/epics/17-free-snapshot.md's
  // explicit "not the lead's real ID — don't leak enumerable IDs on a
  // public endpoint" instruction) — `id` above is a sequential-enough,
  // FK-linked UUID an authenticated CRM user can already see via
  // `leads.snapshot_id`, so it is never accepted as the public lookup key.
  // Only the SHA-256 hash of a 32-byte random token is stored, same
  // "generate once, hash at rest, hand the raw value to the caller a single
  // time" pattern `lib/tokens.ts`'s `generateOpaqueToken`/`hashToken` already
  // establishes for magic links and refresh tokens — a leaked database
  // export still cannot be used to enumerate/guess a live report URL.
  token_hash String @unique(map: "snapshot_requests_token_hash_unique") @db.VarChar(64)

  organizations organizations? @relation(fields: [converted_to_org_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  leads         leads[] // Epic 1 (CRM): a CRM lead optionally originates from a free-snapshot request

  @@index([domain, created_at(sort: Desc)], map: "idx_snapshot_domain")
  @@index([email], map: "idx_snapshot_email")
  @@index([ip_address, created_at(sort: Desc)], map: "idx_snapshot_ip")
}

