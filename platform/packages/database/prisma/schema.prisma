  competitors        competitors?    @relation(fields: [competitor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  intents            intents?        @relation(fields: [intent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user    users?          @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
