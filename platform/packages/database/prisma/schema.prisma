model measurement_points {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String                    @db.Uuid
  brand_id                String                    @db.Uuid
  name                    String                    @db.VarChar(255)
  batch_run_id            String?                   @db.Uuid
  overall_score           Decimal?                  @db.Decimal(5, 2)
  visibility_score        Decimal?                  @db.Decimal(5, 2)
  sentiment_score         Decimal?                  @db.Decimal(5, 2)
  recommendation_score    Decimal?                  @db.Decimal(5, 2)
  competitor_count        Int?
  question_count          Int?
  metadata                Json?
  measured_at             DateTime?                 @db.Timestamptz(6)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  measurement_annotations measurement_annotations[]
  organizations           organizations             @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                  brands                    @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([brand_id], map: "idx_measurement_points_brand")
  @@index([measured_at], map: "idx_measurement_points_measured_at")
}

model measurement_annotations {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String             @db.Uuid
  brand_id             String             @db.Uuid
  measurement_point_id String             @db.Uuid
  text                 String
  annotation_type      String?            @default("note") @db.VarChar(50)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  organizations        organizations      @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands               brands             @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  measurement_points   measurement_points @relation(fields: [measurement_point_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([measurement_point_id], map: "idx_measurement_annotations_point")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model notification_preferences {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  notification_type notification_type
  channel           notif_channel
  enabled           Boolean           @default(true)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, notification_type, channel])
  @@index([user_id], map: "idx_notif_prefs_user")
}

// Epic 15 (Reporting & Notifications) widens this pre-existing, already-
// RLS-hardened, ported-but-dormant table (0000_init's rls.sql already has
// its `tenant_isolation` policy) — same reuse-forward precedent as
// `reports` above. Two changes from the legacy shape:
//   - `user_id` NOT NULL -> nullable: this epic's domain model explicitly
//     distinguishes an org-wide notification (`user_id: null` — e.g. a
//     `competitor_alert` visible to every member) from a per-user one (e.g.
//     `weekly_digest`/`report_ready`, addressed to whoever generated or is
//     entitled to see it). `onDelete` changes Cascade -> SetNull to match:
//     deleting a user should never silently delete an org-wide audit trail
//     row, and a per-user row losing its user still has a real
//     organization_id to stay governed by RLS under.
//   - `channel notif_channel` (was previously only a column on
//     `notification_preferences`, never on `notifications` itself) and
//     `sent_at` are added — the spec's literal `channel: in_app|email` +
//     `sent_at` domain-model fields. `lib/notifications/notify.ts` writes
//     ONE row per channel actually attempted (an in_app row is always
//     written; an email row is written only when a per-user recipient's
//     address is resolvable — see that file's own header comment for the
//     honest scope boundary on org-wide email fan-out).
// Per-user VISIBILITY within an org (a `user_id: null` row is visible to
// every member, a `user_id: <uuid>` row only to that member) is enforced at
// the application layer (`routes/notifications.ts`'s own WHERE clause), not
// by RLS — RLS's `tenant_isolation` policy here (like every other table's)
// only ever enforces the organization_id boundary, the one thing ADR-005
// makes a hard DB-level guarantee; same-org, different-member visibility is
// not a tenant-isolation concern in the sense RLS exists for.
model notifications {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?           @db.Uuid
  organization_id String            @db.Uuid
  type            notification_type
  channel         notif_channel     @default(in_app)
  title           String            @db.VarChar(255)
  body            String?
  action_url      String?           @db.VarChar(500)
  read_at         DateTime?         @db.Timestamptz(6)
  sent_at         DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?            @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id], map: "idx_notifications_org")
  @@index([user_id, read_at, created_at(sort: Desc)], map: "idx_notifications_user")
}

