/// The underlying table has no single-column unique identifier so Prisma
/// Client cannot manage rows directly (@@ignore). RLS is still enforced on
/// it at the database level via raw SQL (see rls.sql) since it stores
/// tenant-scoped join data.
model brand_categories {
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  category_id     String        @db.Uuid
  is_primary      Boolean?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories      categories    @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brand_id], map: "idx_brand_categories_brand")
  @@index([category_id], map: "idx_brand_categories_category")
  @@ignore
}

model competitors {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  brand_id              String                  @db.Uuid
  name                  String                  @db.VarChar(255)
  website_url           String?                 @db.VarChar(500)
  description           String?
  competition_type      competition_type?
  // Epic 2 (Brand Intelligence) addition — the original ported schema had
  // no priority/aliases columns even though docs/06-database/SCHEMA.md and
  // docs/epics/02-brand-intelligence.md both specify them (1=primary/
  // 2=secondary/3=watch tiering, plus AI-facing name variants). Added here
  // rather than worked around in the API because they're core, queryable
  // attributes of a competitor row, not derived data — see
  // packages/database/DECISIONS.md §13.
  //
  // Post-verification fix: §13's first pass modeled this as an enum
  // (`primary`/`secondary`/`watch`) "consistent with `competition_type`."
  // Re-reading SCHEMA.md's literal DDL line for this table —
  // `priority SMALLINT NOT NULL DEFAULT 1, -- 1=primary, 2=secondary,
  // 3=watch` — shows the spec itself specifies a numeric SMALLINT, not a
  // string enum; the frontend's `CompetitorPriority = 1 | 2 | 3` was right
  // and this schema was the side that deviated. Fixed to `Int @db.SmallInt`
  // — see DECISIONS.md §15.
  priority              Int                     @default(1) @db.SmallInt
  aliases               String[]                @default([])
  created_by            String?                 @db.Uuid
  updated_by            String?                 @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?               @db.Timestamptz(6)
  competitor_mentions   competitor_mentions[]
  competitor_visibility competitor_visibility[]
  organizations         organizations           @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                brands                  @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user       users?                  @relation("competitors_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user       users?                  @relation("competitors_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  gap_analysis          gap_analysis[]
  // Epic 8 (Competitive Intelligence) addition — see `ai_runs.competitor_id`.
  ai_runs               ai_runs[]

  @@index([brand_id], map: "idx_competitors_brand")
  @@index([organization_id], map: "idx_competitors_org")
}

// ── Epic 2 (Brand Intelligence) additions ───────────────────────────────────
// The ported schema had `brands` and `competitors` (hardened in Epic 0) but
// no tables at all for `use_cases` or `brand_claims`, and its existing
// `entities` table (further down, near `analyses`) is an AI-extraction
// artifact keyed to a required `analysis_id` — a different concept from the
// "entities this brand should be associated with" profile data the epic
// spec describes (this collision was flagged in advance — see
// packages/database/DECISIONS.md §12). `brand_entities` below is the
// brand-profile table; the original `entities` table is untouched.
//
// All three follow the exact same hardening rules Epic 0 applied everywhere
// else: organization_id denormalized + indexed (for RLS), soft delete,
// UUID pk, created_by/updated_by (human-authored profile data, so — unlike
// the AI-pipeline tables — these ARE tracked), Restrict on the org/brand FK,
// SetNull on the optional user FK. See prisma/migrations/0001_brand_intelligence/
// for the accompanying RLS policies (schema-only — not applied to any DB,
// same as 0000_init).

model brand_entities {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  brand_id        String    @db.Uuid
  name            String    @db.VarChar(255)
  // schema.org type (e.g. "Product", "Service", "SoftwareApplication") —
  // deliberately unconstrained VARCHAR, not an enum: schema.org's type
  // vocabulary is large and extensible, and GEO's entity-association-gap
  // check (Epic 8) will want to compare against whatever a crawl or an LLM
  // returns without this table gatekeeping the value. Same reasoning as
  // DECISIONS.md §6's "deliberately not constrained" list.
  schema_type     String?   @db.VarChar(100)
  description     String?
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user users?        @relation("brand_entities_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user users?        @relation("brand_entities_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id], map: "idx_brand_entities_brand")
  @@index([organization_id], map: "idx_brand_entities_org")
}

