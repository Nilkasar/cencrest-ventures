// ============================================================================
// ACTION CENTER
// ============================================================================

// Epic 13 (Action Center & Controlled Publishing) — `actions` already existed
// (ported in Epic 0 from `docs/06-database/SCHEMA.md`'s Opportunity section)
// but as a generic, never-consumed "action item" shape (title/priority/
// source/source_id/assigned_to/due_date) with zero application code touching
// it anywhere (confirmed by grep before this epic's first edit) — not the
// approve -> execute -> rollback lifecycle SCHEMA.md's own literal `actions`
// DDL (§4) actually specifies (`recommendation_id`/`autonomy_level`/
// `approved_by`/`approved_at`/`executed_at`/`rolled_back_at`/`result`). Same
// "already-ported table missing the fields this epic needs, extend it"
// resolution §25 already used for `content_briefs`' missing
// `recommendation_id` — every pre-existing column is kept (harmless,
// orthogonal, zero risk since nothing reads/writes them yet); this epic adds
// exactly the domain-model columns it needs. `status`'s vocabulary is
// widened from Epic 0's placeholder set to this epic's real lifecycle — see
// checks.sql; safe because, again, zero rows/callers exist yet. Full
// reasoning: DECISIONS.md §27.
model actions {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String         @db.Uuid
  brand_id         String         @db.Uuid
  action_type      String         @db.VarChar(100)
  title            String         @db.VarChar(500)
  description      String?
  priority         String         @default("medium") @db.VarChar(20) // low, medium, high, critical — see checks.sql
  // pending -> approved -> completed (executed), or rolled_back — this
  // epic's real approve/execute/rollback lifecycle (`docs/epics/
  // 13-action-center-publishing.md`'s literal domain model). Widened from
  // Epic 0's placeholder {pending, in_progress, completed, dismissed} — see
  // checks.sql / DECISIONS.md §27.
  status           String         @default("pending") @db.VarChar(50)
  source           String?        @db.VarChar(100)
  source_id        String?        @db.Uuid
  assigned_to      String?        @db.Uuid
  created_by       String?        @db.Uuid
  updated_by       String?        @db.Uuid
  due_date         DateTime?      @db.Timestamptz(6)
  completed_at     DateTime?      @db.Timestamptz(6)
  metadata         Json           @default("{}")
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?      @db.Timestamptz(6)

  // ── Epic 13 additions ─────────────────────────────────────────────────
  // The SOURCE recommendation, when this action traces back to one (real
  // FK, never required — a Level 1-3 agent-originated action has no
  // recommendation of its own). Restrict: this row is a durable
  // approve/execute/rollback audit trail once it exists; the source
  // recommendation being later dismissed must never cascade-delete it —
  // same reasoning `content_briefs.recommendation_id` (§25) already uses.
  recommendation_id String? @db.Uuid
  // 1-4, `docs/06-database/SCHEMA.md`'s literal domain model ("1=recommend,
  // 2=draft, 3=approve+exec, 4=autonomous"). Deliberately NOT narrowed to
  // 1-3 at the DB layer the way `agent_runs.autonomy_level` is (0014's
  // `chk_agent_runs_autonomy_level`) — this epic's own non-negotiable is
  // that the Level 4 block be "enforceable by reading the execute
  // function's guard clause," i.e. proven even when a row legitimately
  // holds 4 (a manually-crafted/corrupted row), not merely prevented from
  // existing. See `chk_actions_level4_never_executes` (checks.sql) for the
  // DB-level belt-and-suspenders on top of that application guard.
  autonomy_level Int @default(1) @db.SmallInt
  // Set ONLY by `POST /actions/:id/approve`, from the real authenticated
  // caller (`c.get('user').id`) — never client-supplied. This IS the
  // "prior approved_at timestamp set by a real user action" this epic's
  // whole non-negotiable exists to guarantee.
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)
  // Set ONLY by `POST /actions/:id/execute`, and only once (`executed_at`
  // being already-set makes a second execute idempotent, never a second
  // publish — see routes/action-details.ts).
  executed_at DateTime? @db.Timestamptz(6)
  // Set ONLY by `POST /actions/:id/rollback`, only within the 30-day
  // window measured from `executed_at` (see `lib/actions/rollback-
  // window.ts` — a resolved ambiguity, documented in this epic's backend
  // doc, over which of `approved_at`/`executed_at` the spec's "30-day
  // rollback window" is measured from).
  rolled_back_at DateTime? @db.Timestamptz(6)
  // Open pointer to what execute/rollback actually did (e.g.
  // `{ publishedContentId, destinationRef }`) — same "small summary
  // pointer, not the full record" reasoning `agent_runs.result_id` already
  // uses; the FULL `PublishTarget` result lives on `published_content.
  // result` below, this is a convenience summary on the action itself.
  result Json?
  // The two handoff sources this epic's spec names by name (end-to-end
  // flow step 1): an approved `content_drafts` row (Epic 11) or an
  // approved `agent_pending_actions` row (Epic 12). Real FKs, never a
  // re-typed copy of the source row's own fields — mutually exclusive per
  // row (`chk_actions_single_handoff_source`, checks.sql): a given action
  // has exactly one real origin, or neither (a directly-created action,
  // not exercised by this build but not precluded by the schema either).
  // `@unique` on each: idempotent handoff — a given draft/pending-action
  // can only ever spawn ONE actions row, ever.
  content_draft_id        String? @unique @db.Uuid
  agent_pending_action_id String? @unique @db.Uuid

  // ── Epic 14 (Measurement & Learning Loop) addition ─────────────────────
  // The immutable "before" baseline this epic's whole non-negotiable exists
  // to protect: "the before-score must be snapshotted AT APPROVAL TIME, not
  // measurement time." Written ONLY by `POST /actions/:id/approve` (see
  // routes/action-details.ts), from the brand's CURRENT already-computed
  // AI-visibility/SEO scores at that exact moment
  // (`lib/measurement/current-score-snapshot.ts`'s `getCurrentScoreSnapshot`
  // — reads Epic 7's `ai_runs`/Epic 4's `seo_analyses`, never recomputes
  // anything) — never re-read live at measurement time, which is exactly
  // the corruption this non-negotiable guards against ("a score that
  // already changed for unrelated reasons corrupts the comparison"). No
  // other code path in this build ever writes to these two columns after
  // approval (confirmed by grep before this epic's first edit) — set
  // together, all-or-nothing (`chk_actions_before_score_together`,
  // checks.sql). `measurements.before_score` is a SECOND, independent copy
  // taken from this column at measurement-creation time, never from live
  // brand data — see that model's own comment for why the snapshot lives
  // in two places. Full reasoning: DECISIONS.md §28.
  before_score             Json?
  before_score_captured_at DateTime? @db.Timestamptz(6)

  assigned_to_user     users?                 @relation("actions_assigned_to", fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by_user      users?                 @relation("actions_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user      users?                 @relation("actions_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approved_by_user     users?                 @relation("actions_approved_by", fields: [approved_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  brands               brands                 @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  opportunity_recommendations opportunity_recommendations? @relation(fields: [recommendation_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  content_drafts       content_drafts?        @relation(fields: [content_draft_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agent_pending_actions agent_pending_actions? @relation(fields: [agent_pending_action_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  publish_jobs         publish_jobs[]
  published_content    published_content?
  measurements         measurements[]

  @@index([brand_id], map: "idx_actions_brand")
  @@index([priority], map: "idx_actions_priority")
  @@index([status], map: "idx_actions_status")
  @@index([status, priority], map: "idx_actions_status_priority")
  @@index([recommendation_id], map: "idx_actions_recommendation")
}

// Epic 13 (Action Center & Controlled Publishing) — the internal, real
// record of "what was published and where" (spec's literal domain-model
// bullet; `docs/06-database/SCHEMA.md`'s Content schema group's 4th table,
// listed there but never actually given a DDL body — this epic writes the
// first one). A NEW table, deliberately NOT a reuse of the pre-existing
// `publish_jobs` (also ported in Epic 0) — `publish_jobs` is shaped for a
// real, multi-destination external-CMS publish workflow this epic
// explicitly does not build (`destination_config`/`scheduled_at`/
// `rejection_reason`/`publish_log`, none of which this epic's
// `NullPublishTarget` would ever populate) — same "a different, wrong-
// shaped table for a concern this epic doesn't own, left alone" resolution
// DECISIONS.md already applies repeatedly (§22/§24/§25's own treatment of
// `generated_content` vs. `content_drafts`). Full reasoning: DECISIONS.md
// §27. `publish_jobs` itself is untouched by this epic.
model published_content {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  // The action this row is the execution RESULT of. Restrict (never
  // Cascade): a published record must survive even if something else tried
  // to remove its parent action — same durable-artifact reasoning
  // `content_briefs.recommendation_id` already documents. `@unique`:
  // exactly one publish record per action, ever (`POST .../execute`'s own
  // guard clause makes a second call on an already-executed action
  // idempotent rather than a second create — see routes/action-details.ts).
  action_id String @unique @db.Uuid
  // `PublishTarget.name` (`lib/actions/publish-target.ts`) — which
  // implementation actually wrote this row, e.g. `internal_record` for the
  // shipped `NullPublishTarget`. Real, not a hardcoded literal, so a future
  // genuine CMS integration is traceable per row without a schema change.
  publish_target String @db.VarChar(100)
  // Where the content now "lives," per the `PublishTarget`'s own result.
  // For `NullPublishTarget` this is always an internal locator
  // (`internal://...`) — NEVER a real external URL, this epic's explicit,
  // documented scope boundary (no real CMS integration exists yet).
  destination_ref String
  // Snapshot of what was actually published — from `content_drafts` when
  // the parent action originated from one (`actions.content_draft_id`);
  // null for a Level 1-3 agent-originated action with no draft of its own.
  // Same "snapshot, don't re-read live" reasoning `content_briefs.
  // evidence_summary` (§25) already uses: a later edit to the source draft
  // must never retroactively change what this record says was published.
  title String? @db.VarChar(500)
  body  String?
  // published | rolled_back — see checks.sql.
  status       String   @default("published") @db.VarChar(20)
  published_at DateTime @default(now()) @db.Timestamptz(6)
  // Snapshot of `actions.approved_by` — the real, human, owner/admin
  // approver who authorized this specific publish. Copied from the parent
  // action's own already-verified column at execute time, never re-derived
  // or client-supplied here.
  published_by   String?   @db.Uuid
  rolled_back_at DateTime? @db.Timestamptz(6)
  rolled_back_by String?   @db.Uuid
  // The raw `PublishTarget` result payload — never discarded once a status
  // is derived from it, same "keep the check's own evidence" reasoning
  // `content_quality_checks.details` already uses.
  result     Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  organizations       organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands              brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actions             actions       @relation(fields: [action_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  published_by_user   users?        @relation("published_content_published_by", fields: [published_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rolled_back_by_user users?        @relation("published_content_rolled_back_by", fields: [rolled_back_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id, brand_id], map: "idx_published_content_brand")
  @@index([status], map: "idx_published_content_status")
}

// ============================================================================
// MEASUREMENT & LEARNING LOOP (Epic 14) — the RE-MEASURE -> LEARN -> IMPROVE
// stages, closing the loop back to Epic 9's REPEAT. Full reasoning:
// DECISIONS.md §28.
// ============================================================================

// The RE-MEASURE step's own durable record: one `actions` row's real
// before/after AI-visibility/SEO comparison, plus an honest, confidence-
// labeled attribution ESTIMATE (never asserted as proof) of whether this
// specific action plausibly caused the change. `docs/13-agents/
// AGENT_ARCHITECTURE.md`'s Measurement Agent + this epic's spec, verbatim.
model measurements {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  // Denormalized (not read through action_id -> actions -> brand_id) —
  // same "denormalize the tenant/brand key so a list route never needs a
  // join to scope itself" precedent `opportunity_recommendations.brand_id`
  // already sets (DECISIONS.md §22/§24). Also what `GET /brands/:id/
  // measurements`'s own literal route addresses by.
  brand_id String @db.Uuid
  // Restrict (never Cascade): a measurement is a durable evidence record —
  // same "outlives any one reference" reasoning `content_briefs.
  // recommendation_id` already documents — it must survive even if
  // something else tried to remove its parent action. Not `@unique`: a
  // brand could in principle be re-measured more than once (a future
  // "re-run the 4-week check" manual trigger); nothing in this build
  // relies on at-most-one-measurement-per-action.
  action_id String @db.Uuid

  // ── The non-negotiable: before = the score AT APPROVAL TIME, snapshotted
  // then, never recomputed from possibly-changed live data. ──────────────
  // A SECOND, independent copy of `actions.before_score`/
  // `.before_score_captured_at`, taken at THIS ROW's creation time — never
  // re-read from the (mutable) `actions` row or from live brand data. Two
  // independent copies (one on `actions`, captured at approval; one here,
  // captured at measurement-creation, itself copied only from the first)
  // mean a hypothetical future bug that mutated the `actions` column after
  // approval could corrupt only a NOT-YET-CREATED measurement, never an
  // already-written one — this row, once created, cannot be affected by
  // anything that happens to `actions` afterward. See
  // `lib/measurement/run-measurement.ts`'s own header comment for the
  // actual read/copy code path, and DECISIONS.md §28 for the full
  // "column vs. separate mechanism" design writeup this epic's task
  // required.
  before_score             Json
  before_score_captured_at DateTime @db.Timestamptz(6)
  // The RE-RUN result: Epic 7's real `runAiVisibilityStep`/
  // `runAiVisibilityRun` (GEO, same query set) and/or Epic 4's real
  // `runTechnicalChecklist`/`runContentChecklist` (SEO) — never a
  // reimplementation of either. Same shape as `before_score` (see
  // `lib/measurement/current-score-snapshot.ts`'s `ScoreSnapshot`), so a
  // caller can diff the two directly field-for-field.
  after_score Json
  // Set when this measurement's GEO component came from a fresh re-run —
  // the real `ai_runs` row that produced `after_score.geo`, so a caller can
  // trace the after-side evidence exactly the way `after_score` itself
  // already lets a caller trace the raw comparison. Null when GEO could not
  // be re-run (no active query set, or an entitlement limit blocked it —
  // `after_score.geo` is null in that case too, never fabricated).
  after_ai_run_id String? @db.Uuid
  // Pure function of (before_score, after_score) —
  // `lib/measurement/scoring.ts`'s `computeScoreDelta`, unit-tested in
  // isolation with zero database/AI-provider/clock dependency. Nullable:
  // a delta is genuinely uncomputable when neither side has a comparable
  // GEO or SEO component (e.g. the brand had no baseline data at all when
  // the action was approved) — left null rather than coerced to a
  // misleading 0.
  score_delta Decimal? @db.Decimal(6, 2)
  // Reuses `claim_confidence` (high|medium|low) — the identical closed
  // vocabulary `brand_observations.extraction_confidence` already uses
  // (Epic 7) for "how much should a reader trust this derived value,"
  // rather than a second enum with the exact same three values (DECISIONS.md
  // §6's "don't duplicate a vocabulary that already exists under a generic
  // enough name" precedent). Set by `lib/measurement/attribution.ts`'s
  // `estimateAttribution` — deliberately never asserts causal certainty
  // (this epic's own non-negotiable #4): "did THIS action plausibly cause
  // the change, or did something else move," per AGENT_ARCHITECTURE.md's
  // own "attribution estimate," not proof.
  attribution_confidence claim_confidence
  // Plain-language explanation of the confidence level above — ALWAYS
  // phrased as an estimate ("likely," "plausibly," "cannot rule out"),
  // never as a proof of causation. See `attribution.ts`'s own doc comment
  // for the exact rules that produce this text.
  attribution_notes String
  measured_at        DateTime @default(now()) @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands            @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actions         actions           @relation(fields: [action_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ai_runs         ai_runs?          @relation(fields: [after_ai_run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  outcome_records outcome_records[]

  @@index([brand_id, measured_at], map: "idx_measurements_brand_measured_at")
  @@index([action_id], map: "idx_measurements_action")
  @@index([organization_id], map: "idx_measurements_org")
}

// The LEARN step's own durable record — spec's literal domain model,
// verbatim: "recording the outcome (opportunity_type x action_type x
// observed score delta) in a queryable table, NOT a real ML model." This
// table IS the honest scope boundary this epic's spec draws around "the
// learning model": a real pattern-recognition/formula-refinement system
// (`PRODUCT_VISION.md` Layer 8) is documented future work this table's own
// data would eventually feed, alongside Epic 8's `competitor_visibility`
// change feed (the spec's own "two feeds a real learning system would
// eventually consume") — nothing in this build reads these rows back to
// change any formula or recommendation.
//
// `opportunity_type`/`action_type` are the REAL enums Epic 9/Epic 10 already
// defined (`unified_opportunity_type`, `recommendation_action_type`) reused
// directly, never re-typed as a guessed string — this epic's own explicit
// "not guessed or hardcoded" instruction. Written ONLY when the measured
// action's `recommendation_id` resolves through the real chain
// (actions -> opportunity_recommendations -> unified_opportunities); a
// Level 1-3 agent-originated action with no recommendation of its own
// produces a `measurements` row but deliberately NO `outcome_records` row —
// see `lib/measurement/run-measurement.ts`'s own header comment and this
// epic's backend doc's "not done" list for the honest reasoning.
model outcome_records {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String @db.Uuid
  // The measurement this outcome derives from — not in the spec's own
  // literal domain-model bullet, but required by its "written alongside the
  // measurements row" instruction (same "handoff FK the domain model
  // doesn't name but the spec's own non-negotiable requires" precedent
  // Epic 13's `content_draft_id`/`agent_pending_action_id` already set,
  // DECISIONS.md §27). Cascade: an outcome record has no independent
  // meaning without the measurement it summarizes — same composition-child
  // reasoning `opportunity_evidence` already uses under its parent
  // opportunity.
  measurement_id  String                     @db.Uuid
  opportunity_type unified_opportunity_type
  action_type      recommendation_action_type
  score_delta      Decimal?                  @db.Decimal(6, 2)
  created_at       DateTime                  @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  measurements  measurements  @relation(fields: [measurement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // The future cross-customer pattern-learning query this table exists
  // for, verbatim from the spec's own parenthetical: "opportunity_type x
  // action_type x observed score delta."
  @@index([opportunity_type, action_type], map: "idx_outcome_records_type_pair")
  @@index([organization_id], map: "idx_outcome_records_org")
  @@index([measurement_id], map: "idx_outcome_records_measurement")
}

// ============================================================================
// AGENTS (GEO / SEO / Growth) — run as `system` role, see SECURITY.md
// ============================================================================

model geo_agent_runs {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String              @db.Uuid
  brand_id                String              @db.Uuid
  status                  String              @default("pending") @db.VarChar(50) // pending, running, completed, failed — see checks.sql
  trigger                 String              @default("manual") @db.VarChar(50) // manual, scheduled — see checks.sql
  gaps_processed          Int                 @default(0)
  content_generated       Int                 @default(0)
  recommendations_applied Int                 @default(0)
  summary                 Json                @default("{}")
  error_message           String?
  started_at              DateTime?           @db.Timestamptz(6)
  completed_at            DateTime?           @db.Timestamptz(6)
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @default(now()) @db.Timestamptz(6)
