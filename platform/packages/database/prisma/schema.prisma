// Epic 15 (Reporting & Notifications) widens this pre-existing, already-
// RLS-hardened, ported-but-dormant table (0000_init's rls.sql already has
// its `tenant_isolation` policy; nothing in any verified epic wrote to it
// before this one — same "reuse the pre-existing hardened table, widen
// forward, never invent a parallel one" precedent Epic 18 already set for
// `white_label_configs`, see @bebest/database DECISIONS.md's Epic 18
// section) rather than creating a second `reports`-shaped table under a new
// name. `type`/`format`/`status`/`name`/`metadata`/`file_path`/
// `created_by`/`completed_at` are the untouched legacy columns; `period_
// start`/`period_end`/`generated_at`/`content` are this epic's additions —
// see docs/epics/15-reporting-notifications.md's literal domain model.
//
// `content` is the non-negotiable: the FULL assembled report data, written
// once at generation time and NEVER re-derived on read — a report generated
// today must render identically next month even if the brand's live scores
// change (see `lib/reporting/generate-report.ts`'s own header comment and
// `lib/reporting/immutability.test.ts` for the explicit proof). `file_path`
// (legacy) doubles as this epic's `pdf_url` — PDF export is documented
// nice-to-have, never blocking (this epic's spec, verbatim); nothing in
// this build ever writes it, so it stays `null` on every row today.
// `type` keeps its legacy `String @db.VarChar(50)` shape rather than a new
// Prisma enum (Prisma enums cannot be added to an already-shipped column
// without a data migration this package never runs against a real
// database) — the closed `weekly|monthly|custom|baseline_comparison`
// vocabulary is enforced by `chk_reports_type`
// (`prisma/migrations/0018_reporting_notifications/checks.sql`), same
// "CHECK constraint on a genuinely closed VARCHAR taxonomy" discipline
// every other epic in this schema already follows (DECISIONS.md §6).
model reports {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  name            String        @db.VarChar(255)
  type            String        @db.VarChar(50)
  format          String        @db.VarChar(20)
  status          run_status
  file_path       String?       @db.VarChar(500)
  metadata        Json?
  // ── Epic 15 additions ────────────────────────────────────────────────
  period_start  DateTime @db.Timestamptz(6)
  period_end    DateTime @db.Timestamptz(6)
  generated_at  DateTime @default(now()) @db.Timestamptz(6)
  content       Json
  // ─────────────────────────────────────────────────────────────────────
  created_by      String        @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  completed_at    DateTime?     @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users           users         @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([brand_id], map: "idx_reports_brand")
  @@index([type], map: "idx_reports_type")
  @@index([organization_id, brand_id, type, generated_at(sort: Desc)], map: "idx_reports_org_brand_type_generated")
}

