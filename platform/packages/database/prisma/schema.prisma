  action_id            String?            @db.Uuid
  destination          String             @db.VarChar(100)
  destination_config   Json               @default("{}")
  status               String             @default("draft") @db.VarChar(50) // draft, scheduled, published, failed, rejected — see checks.sql
  scheduled_at         DateTime?          @db.Timestamptz(6)
  published_at         DateTime?          @db.Timestamptz(6)
  published_url        String?
  approval_required    Boolean            @default(true)
  approved_by          String?            @db.Uuid
  approved_at          DateTime?          @db.Timestamptz(6)
  rejection_reason     String?
  publish_log          Json               @default("[]")
