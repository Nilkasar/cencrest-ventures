// ── Epic 1 (CRM) additions ───────────────────────────────────────────────────
// `docs/06-database/SCHEMA.md` §5 defines `leads` and `activities` but never
// gives `accounts` or `deals` a CREATE TABLE (see docs/epics/01-crm.md for
// the full gap analysis). Resolution, per that spec:
//   - `accounts` is NOT a table — it's a read view assembled by
//     apps/api/src/routes/accounts.ts over `organizations` + `leads` +
//     `deals` + `activities`. No schema change needed for it.
//   - `deals` is a genuinely new table, defined below.
//   - `leads`/`activities` are new tables too — the existing `crm_contacts`/
//     `crm_notes` tables (above) are a DIFFERENT, already-shipped concept
//     (post-signup contacts/notes on an existing paying org) and are left
//     untouched.
//
// Tenant scoping (the one deliberate, documented deviation from the spec's
// literal field list — see DECISIONS.md "Epic 1 — CRM" for the full
// argument, and packages/database/prisma/migrations/0002_crm/ for the
// accompanying RLS/CHECK/index SQL, kept in its own epic-scoped migration
// folder alongside 0000_init, same convention as Epic 2's
// 0001_brand_intelligence folder above — numbered 0002 because Epic 2 was
// being built concurrently and landed the 0001 slot first, see
// 0002_crm/rls.sql's header for the full renumbering note):
//
//   CRM is an internal/ops tool in v1 (docs/epics/01-crm.md's Entitlements
//   section) — BeBest staff manage their own pipeline, customers never see
//   any of this. So `leads.organization_id`, `deals.organization_id`, and
//   `activities.organization_id` are NOT NULL and ALWAYS resolve to one
//   fixed, well-known "internal BeBest operations" organization row
//   (apps/api resolves its id from `CRM_INTERNAL_ORG_ID`, see that app's
//   README) — never null, never the customer's org. This lets the standard
//   `tenant_isolation` RLS policy (organization_id = app.current_org) apply
//   to these three tables with ZERO special-casing, which matters a lot
//   given this schema's own history of subtle, hard-to-get-right special
//   cases for nullable/dual-purpose organization_id columns (memberships,
//   organization_rate_limits, invitations — see DECISIONS.md §7a/§7b). A
//   nullable, sometimes-tenant-sometimes-not organization_id (the spec's
//   literal reading) would either be permanently invisible to any ordinary
//   role while null (the `background_jobs` pattern — unacceptable here,
//   staff need to actually work these rows daily) or require a bespoke RLS
//   policy that's one more place to get tenant isolation subtly wrong.
//
//   The spec's actual intent — "which real customer org did this become /
//   belong to" — is preserved, just under an unambiguous name so it never
//   collides with the RLS-scoping column: `leads.converted_organization_id`
//   (set only at conversion) and `deals.account_organization_id` /
//   `activities.account_organization_id` (set at creation if the row is
//   already tied to an existing account, or backfilled at lead-conversion
//   time for anything hanging off that lead). All three are plain nullable
//   FKs with no RLS role of their own.

model leads {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String      @db.Uuid // RLS tenant-scope column — see note above; always the internal ops org
  email           String      @db.VarChar(255)
  name            String      @db.VarChar(255)
  company         String?     @db.VarChar(255)
  website         String?     @db.VarChar(500)
  category        String?     @db.VarChar(100)
  notes           String?
  source          lead_source @default(direct)
  source_url      String?     @db.VarChar(2048)
  status          lead_status @default(new)
  score           Int?        @db.SmallInt // 0-100, see checks.sql
  assigned_to     String?     @db.Uuid
  snapshot_id     String?     @db.Uuid

  // Set only when this lead converts into a paying customer (see
  // POST /leads/:id/convert). NOT the tenant-scope column — see
  // `organization_id` above.
  converted_organization_id String?   @db.Uuid
  converted_at              DateTime? @db.Timestamptz(6)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  organizations          organizations      @relation("leads_organization", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  converted_organization organizations?     @relation("leads_converted_organization", fields: [converted_organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assigned_to_user       users?             @relation("leads_assigned_to", fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by_user        users?             @relation("leads_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user        users?             @relation("leads_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  snapshot_requests      snapshot_requests? @relation(fields: [snapshot_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deals                  deals[]
  activities             activities[]

  @@index([organization_id], map: "idx_leads_org")
  @@index([status], map: "idx_leads_status")
  @@index([source], map: "idx_leads_source")
  @@index([assigned_to], map: "idx_leads_assigned_to")
  @@index([converted_organization_id], map: "idx_leads_converted_org")
  @@index([email], map: "idx_leads_email")
  @@index([snapshot_id], map: "idx_leads_snapshot")
}

/// `probability` (0-100) and `value_cents` (>= 0) get CHECK constraints —
/// see prisma/migrations/0002_crm/checks.sql.
model deals {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String     @db.Uuid // RLS tenant-scope column — see note above; always the internal ops org
  lead_id                 String?    @db.Uuid
  account_organization_id String?    @db.Uuid // the real customer org this deal belongs to, once known
  title                   String     @db.VarChar(255)
  value_cents             Int        @default(0)
  currency                String     @default("USD") @db.VarChar(3)
  stage                   deal_stage @default(new)
  probability             Int?       @db.SmallInt
  expected_close_date     DateTime?  @db.Timestamptz(6)
  owner_id                String     @db.Uuid
  lost_reason             String?
  created_by              String?    @db.Uuid
  updated_by              String?    @db.Uuid
  created_at              DateTime   @default(now()) @db.Timestamptz(6)
  updated_at              DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at              DateTime?  @db.Timestamptz(6)

  organizations        organizations  @relation("deals_organization", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account_organization organizations? @relation("deals_account_organization", fields: [account_organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  leads                leads?         @relation(fields: [lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  owner                users          @relation("deals_owner", fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user      users?         @relation("deals_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user      users?         @relation("deals_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  activities           activities[]

  @@index([organization_id], map: "idx_deals_org")
  @@index([lead_id], map: "idx_deals_lead")
  @@index([account_organization_id], map: "idx_deals_account_org")
  @@index([stage], map: "idx_deals_stage")
  @@index([owner_id], map: "idx_deals_owner")
}

/// Logged against a lead, a deal, and/or an account org — at least one of
/// `lead_id` / `account_organization_id` must be present (CHECK constraint,
/// see prisma/migrations/0002_crm/checks.sql; Zod also enforces this at the
/// API layer before it ever reaches the DB).
model activities {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @db.Uuid // RLS tenant-scope column — see note above; always the internal ops org
  lead_id                 String?       @db.Uuid
  deal_id                 String?       @db.Uuid
  account_organization_id String?       @db.Uuid
  type                    activity_type
  subject                 String?       @db.VarChar(500)
  body                    String?
  metadata                Json          @default("{}")
  actor_id                String?       @db.Uuid // nullable: system-originated activities (e.g. snapshot_requested) have no human actor
  created_at              DateTime      @default(now()) @db.Timestamptz(6)

  organizations        organizations  @relation("activities_organization", fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account_organization organizations? @relation("activities_account_organization", fields: [account_organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  leads                leads?         @relation(fields: [lead_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deals                deals?         @relation(fields: [deal_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actor                users?         @relation("activities_actor", fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id], map: "idx_activities_org")
  @@index([lead_id, created_at(sort: Desc)], map: "idx_activities_lead_created")
  @@index([account_organization_id, created_at(sort: Desc)], map: "idx_activities_account_created")
  @@index([deal_id], map: "idx_activities_deal")
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

// Epic 18 addition to a pre-existing table: `connected_at`/`disconnected_at`.
// The epic spec's own literal `integrations` shape names `connected_at`
// alongside `status` — distinct from `updated_at` (which also moves on
// unrelated edits, e.g. a future settings tweak) and from `last_synced_at`
// (which is about DATA sync, not the connection lifecycle itself; a
// `MockSearchConsoleProvider` proving the abstraction never actually
// syncs anything real, so `last_synced_at` stays null through this build).
model integrations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String               @db.Uuid
  integration_type   integration_type
  config_enc         Json                 @default("{}")
  status             integration_status   @default(disconnected)
  connected_at       DateTime?            @db.Timestamptz(6)
  disconnected_at    DateTime?            @db.Timestamptz(6)
  last_synced_at     DateTime?            @db.Timestamptz(6)
  created_by         String?              @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user    users?               @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  webhook_deliveries webhook_deliveries[]

  @@unique([organization_id, integration_type])
  @@index([organization_id], map: "idx_integrations_org")
}

model webhook_deliveries {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  integration_id  String        @db.Uuid
  event_type      String        @db.VarChar(100)
  payload         Json          @default("{}")
  status_code     Int?
  response_body   String?
  attempt         Int           @default(1) @db.SmallInt
  delivered_at    DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  integrations    integrations  @relation(fields: [integration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([integration_id, delivered_at(sort: Desc)], map: "idx_webhook_deliveries_integ")
  @@index([organization_id], map: "idx_webhook_deliveries_org")
}

model org_ai_providers {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  provider_name   String        @db.VarChar(50)
  model           String        @db.VarChar(100)
  api_key_enc     String?
  is_active       Boolean       @default(true)
  priority        Int           @default(1) @db.SmallInt
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prompt_jobs     prompt_jobs[]

  @@unique([organization_id, provider_name])
  @@index([organization_id], map: "idx_org_ai_providers_org")
}

// ============================================================================
// AGENCY / WHITE LABEL
// ============================================================================

// Epic 18 (Agency / White Label / Integrations) — this table already
// existed (ported + hardened ahead of this epic, see DECISIONS.md's Epic 18
// section), but modeled only a business relationship (relationship_type/
// access_level/monthly_fee/contract dates), never an ACCESS-CONTROL one.
// The epic's own hard requirement — "an agency cannot unilaterally claim
// any org id... requires an explicit consent/invitation step" — has no
// column to represent "invited but not yet consented" without a change
// here, so five columns are added additively (schema never applied to a
// database — see this package's DECISIONS.md header) and `status`'s closed
// vocabulary widens from {active,paused,terminated} to also include
// `pending` (the new default: a row starts unconsented) and `revoked`
// (access explicitly pulled — distinct from `terminated`'s "contract ended"
// business meaning; this is the value the DoD's "revoking a link
// immediately blocks a subsequent request" test exercises). See
// `apps/api/src/lib/agency-access.ts` for how `access_level` doubles as the
// role granted to an agency user acting as this client (full→admin,
// limited→analyst, read_only→viewer) — reusing this existing column rather
// than adding a fourth, redundant "role" column that could disagree with it.
model agency_clients {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agency_org_id     String    @db.Uuid
  client_org_id     String    @db.Uuid
  relationship_type String    @default("managed") @db.VarChar(50) // managed, consulting, referral — see checks.sql
  access_level      String    @default("full") @db.VarChar(50) // full, limited, read_only — see checks.sql
  monthly_fee       Decimal?  @db.Decimal(10, 2)
  contract_start    DateTime? @db.Timestamptz(6)
  contract_end      DateTime? @db.Timestamptz(6)
  // pending, active, paused, terminated, revoked — see checks.sql (widened
  // by prisma/migrations/0012_agency_white_label_integrations/checks.sql,
  // superseding 0000_init's narrower constraint, same "new migration folder
  // supersedes an earlier one, never edited in place" precedent as
  // 0006_epic5_postverification_fixes).
  status            String    @default("pending") @db.VarChar(50)
  invited_by        String?   @db.Uuid // agency-side user who sent the invitation
  consented_by      String?   @db.Uuid // client-side user who accepted it
  consented_at      DateTime? @db.Timestamptz(6)
  revoked_by        String?   @db.Uuid // either side's user who pulled access
  revoked_at        DateTime? @db.Timestamptz(6)
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  organizations_agency organizations @relation("agency_clients_agency_org_idToorganizations", fields: [agency_org_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organizations_client organizations @relation("agency_clients_client_org_idToorganizations", fields: [client_org_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invited_by_user      users?        @relation("agency_clients_invited_by", fields: [invited_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  consented_by_user    users?        @relation("agency_clients_consented_by", fields: [consented_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  revoked_by_user      users?        @relation("agency_clients_revoked_by", fields: [revoked_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([agency_org_id, client_org_id])
  @@index([agency_org_id], map: "idx_agency_clients_agency")
  @@index([client_org_id], map: "idx_agency_clients_client")
}

model white_label_configs {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String        @unique @db.Uuid
  brand_name         String        @db.VarChar(255)
  logo_url           String?
  primary_color      String?       @db.VarChar(7)
  secondary_color    String?       @db.VarChar(7)
  custom_domain      String?
  support_email      String?       @db.VarChar(255)
  hide_powered_by    Boolean       @default(false)
  custom_terms_url   String?
  custom_privacy_url String?
  enabled            Boolean       @default(true)
  config             Json          @default("{}")
  created_by         String?       @db.Uuid
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?     @db.Timestamptz(6)
  created_by_user    users?        @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organizations      organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

