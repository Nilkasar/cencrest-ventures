// BeBest platform database schema — @bebest/database
//
// This is a hardened port of the previous implementation at
// `api/prisma/schema.prisma`. See ../DECISIONS.md for a full list of
// every change made vs. that original and why.
//
// Design principles (docs/06-database/SCHEMA.md, DECISIONS.md ADR-005):
//   1. Every tenant table carries `organization_id` (denormalized down from
//      `brands.organization_id` where the natural parent is a brand) so a
//      single Row-Level Security policy can filter every table the same way.
//   2. RLS is enabled on every tenant table — see prisma/migrations/0000_init/rls.sql.
//      Prisma does not manage RLS policies, so they live in hand-written SQL
//      (ADR-009 consequence).
//   3. Soft delete (`deleted_at`) on all user-managed, mutable customer data.
//      Append-only evidence/log/analytics tables (AI extraction artifacts,
//      score history, audit/auth events, job queues) are intentionally NOT
//      soft-deleted — they are immutable history, cascade-deleted only with
//      their direct parent.
//   4. All timestamps are `TIMESTAMPTZ` (never bare `TIMESTAMP`).
//   5. UUID primary keys everywhere, generated by Postgres (`gen_random_uuid()`).
//   6. `created_by` / `updated_by` added wherever a human action mutates the
//      row and it wasn't already tracked. Not added to system/AI/pipeline
//      generated rows (there is no human author).
//   7. Enum-like VARCHAR status/priority/role columns keep their VARCHAR type
//      (for forward compatibility / avoiding enum migrations) but get a
//      `CHECK` constraint — see prisma/migrations/0000_init/checks.sql.
//   8. FK `ON DELETE`: `RESTRICT` on every `organization_id` and `brand_id`
//      reference (tenant/brand deletion must be an explicit, audited,
//      application-level workflow — never a silent DB cascade). `CASCADE`
//      only on true composition children (a row with zero independent
//      meaning once its single direct parent is gone, e.g. a citation
//      without its ai_response). See DECISIONS.md for the full table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY
// ============================================================================

model organizations {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  slug       String    @unique(map: "organizations_slug_unique") @db.VarChar(255)
  created_by String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  users users @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  account_health                                              account_health?
  actions                                                      actions[]
  agency_clients_agency_org                                    agency_clients[]        @relation("agency_clients_agency_org_idToorganizations")
  agency_clients_client_org                                    agency_clients[]        @relation("agency_clients_client_org_idToorganizations")
  ai_responses                                                 ai_responses[]
  ai_usage                                                     ai_usage[]
  analyses                                                     analyses[]
  analysis_findings                                            analysis_findings[]
  audiences                                                     audiences[]
  audit_events                                                  audit_events[]
  autonomous_run_logs                                           autonomous_run_logs[]
  autonomous_schedules                                          autonomous_schedules[]
  background_jobs                                               background_jobs[]
  brand_aliases                                                 brand_aliases[]
  brand_categories                                              brand_categories[] @ignore
  brand_keyword_rankings                                        brand_keyword_rankings[]
  brand_services                                                brand_services[]
  brands                                                        brands[]
  buyer_journeys                                                buyer_journeys[]
  categories                                                    categories[]
  category_associations                                         category_associations[]
  citations                                                     citations[]
  competitor_mentions                                           competitor_mentions[]
  competitor_visibility                                         competitor_visibility[]
  competitors                                                   competitors[]
  content_analyses                                              content_analyses[]
  content_briefs                                                content_briefs[]
  crawl_jobs                                                    crawl_jobs[]
  crm_contacts                                                  crm_contacts[]
  crm_notes                                                     crm_notes[]
  customer_health_checks                                        customer_health_checks?
  entities                                                      entities[]
  entrepreneur_stories                                          entrepreneur_stories[]
  experiment_measurements                                       experiment_measurements[]
  experiments                                                   experiments[]
  gap_analysis                                                  gap_analysis[]
  generated_content                                             generated_content[]
  geo_agent_actions                                             geo_agent_actions[]
  geo_agent_runs                                                geo_agent_runs[]
  geo_gaps                                                      geo_gaps[]
  growth_agent_runs                                             growth_agent_runs[]
  growth_levers                                                 growth_levers[]
  gsc_connections                                               gsc_connections[]
  integrations                                                  integrations[]
  intents                                                       intents[]
  invitations                                                   invitations[]
  keyword_clusters                                              keyword_clusters[]
  keywords                                                      keywords[]
  learning_insights                                             learning_insights[]
  learning_signals                                              learning_signals[]
  marketing_campaigns                                           marketing_campaigns[]
  measurement_annotations                                       measurement_annotations[]
  measurement_points                                            measurement_points[]
  memberships                                                   memberships[]
  mention_extractions                                           mention_extractions[]
  mentions                                                      mentions[]
  notifications                                                 notifications[]
  opportunities                                                 opportunities[]
  org_ai_providers                                              org_ai_providers[]
  page_issues                                                   page_issues[]
  pages                                                         pages[]
  products                                                      products[]
  prompt_jobs                                                   prompt_jobs[]
  prompt_runs                                                   prompt_runs[]
  publish_jobs                                                  publish_jobs[]
  query_set_questions                                           query_set_questions[] @ignore
  query_sets                                                    query_sets[]
  questions                                                     questions[]
  recommendations                                               recommendations[]
  reports                                                       reports[]
  responses                                                     responses[]
  runs                                                          runs[]
  score_history                                                 score_history[]
  scores                                                        scores[]
  seo_agent_actions                                             seo_agent_actions[]
  seo_agent_runs                                                seo_agent_runs[]
  share_of_voice                                                share_of_voice[]
  snapshot_requests                                             snapshot_requests[]
  subscriptions                                                 subscriptions?
  usage_records                                                 usage_records[]
  visibility_scores                                             visibility_scores[]
  webhook_deliveries                                            webhook_deliveries[]
  white_label_configs                                           white_label_configs?
  organization_rate_limits                                      organization_rate_limits[]

  @@index([slug], map: "idx_organizations_slug")
}

model users {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique(map: "users_email_unique") @db.VarChar(255)
  password_hash  String?   @db.VarChar(255) // nullable: magic-link-only accounts never set a password
  name           String    @db.VarChar(255)
  avatar_url     String?
  email_verified Boolean?  @default(false)
  last_login_at  DateTime? @db.Timestamptz(6)
  settings       Json      @default("{}")
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  audit_events                                  audit_events[]
  auth_events                                   auth_events[]
  brands_created                                brands[]                   @relation("brands_created_by")
  brands_updated                                brands[]                   @relation("brands_updated_by")
  competitors_created                           competitors[]              @relation("competitors_created_by")
  competitors_updated                           competitors[]              @relation("competitors_updated_by")
  crm_contacts_created                          crm_contacts[]
  crm_notes                                     crm_notes[]
  experiments_created                           experiments[]              @relation("experiments_created_by")
  experiments_updated                           experiments[]              @relation("experiments_updated_by")
  growth_levers_created                         growth_levers[]
  integrations_created                          integrations[]
  invitations                                   invitations[]
  keywords_created                              keywords[]                 @relation("keywords_created_by")
  keywords_updated                              keywords[]                 @relation("keywords_updated_by")
  magic_link_tokens                             magic_link_tokens[]
  marketing_campaigns_created                   marketing_campaigns[]      @relation("marketing_campaigns_created_by")
  marketing_campaigns_updated                   marketing_campaigns[]      @relation("marketing_campaigns_updated_by")
  memberships                                   memberships[]              @relation("memberships_user")
  memberships_created                           memberships[]              @relation("memberships_created_by")
  notification_preferences                      notification_preferences[]
  notifications                                 notifications[]
  organizations_created                         organizations[]
  actions_assigned                              actions[]                  @relation("actions_assigned_to")
  actions_created                               actions[]                  @relation("actions_created_by")
  actions_updated                               actions[]                  @relation("actions_updated_by")
  password_reset_tokens                         password_reset_tokens[]
  publish_jobs_approved                         publish_jobs[]             @relation("publish_jobs_approved_by")
  publish_jobs_created                          publish_jobs[]             @relation("publish_jobs_created_by")
  publish_jobs_updated                          publish_jobs[]             @relation("publish_jobs_updated_by")
  query_sets_created                            query_sets[]               @relation("query_sets_created_by")
  query_sets_updated                            query_sets[]               @relation("query_sets_updated_by")
  questions_created                             questions[]                @relation("questions_created_by")
  questions_updated                             questions[]                @relation("questions_updated_by")
  recommendations_updated                       recommendations[]
  refresh_tokens                                refresh_tokens[]
  reports                                       reports[]
  sessions                                      sessions[]
  content_briefs_created                        content_briefs[]           @relation("content_briefs_created_by")
  content_briefs_updated                        content_briefs[]           @relation("content_briefs_updated_by")
  gap_analysis_updated                          gap_analysis[]
  opportunities_updated                         opportunities[]
  white_label_configs_created                   white_label_configs[]

  @@index([email], map: "idx_users_email")
}

model memberships {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  organization_id String    @db.Uuid
  role            role
  created_by      String?   @db.Uuid // null when created via invitation acceptance rather than a direct admin add
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users         @relation("memberships_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_user users?      @relation("memberships_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([organization_id, user_id])
  @@index([organization_id], map: "idx_memberships_organization")
  @@index([user_id], map: "idx_memberships_user")
}

model invitations {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  invited_by      String    @db.Uuid
  email           String    @db.VarChar(255)
  role            role      @default(member)
  token_hash      String    @unique @db.VarChar(255)
  expires_at      DateTime  @db.Timestamptz(6)
  accepted_at     DateTime? @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  users         users         @relation(fields: [invited_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_invitations_email")
  @@index([organization_id], map: "idx_invitations_org")
  @@index([token_hash], map: "idx_invitations_token")
}

model sessions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique @db.VarChar(255)
  expires_at   DateTime  @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  ip_address   String?   @db.Inet
  user_agent   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expires")
  @@index([token_hash], map: "idx_sessions_token")
  @@index([user_id], map: "idx_sessions_user")
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  session_id String?   @db.Uuid // links a refresh token to the session it rotates within
  token_hash String    @unique @db.VarChar(255) // NEVER store the raw token — only its SHA-256 hash
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_refresh_tokens_expires")
  @@index([token_hash], map: "idx_refresh_tokens_token")
  @@index([user_id], map: "idx_refresh_tokens_user")
}

model magic_link_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @db.VarChar(255)
  user_id    String?   @db.Uuid // null until the account exists (first-time signup)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  ip_address String?   @db.Inet
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  users users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_mlt_email")
  @@index([token_hash], map: "idx_mlt_token")
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token_hash], map: "idx_prt_token")
  @@index([user_id], map: "idx_prt_user")
}

model auth_events {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  event_type String   @db.VarChar(50) // login_success, login_failure, logout, token_refresh, magic_link_sent, magic_link_used
  ip_address String?  @db.Inet
  user_agent String?
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([event_type], map: "idx_auth_events_type")
  @@index([user_id], map: "idx_auth_events_user")
  @@index([created_at], map: "idx_auth_events_created_at")
}

// ============================================================================
// SYSTEM / AUDIT
// ============================================================================

model audit_events {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid // null for system/agent-originated events
  organization_id String?  @db.Uuid // null for platform-level events
  actor_type      String   @default("user") @db.VarChar(20) // user, system, agent
  actor_role      String?  @db.VarChar(50) // role at time of action (point-in-time; roles can change later)
  action          String   @db.VarChar(200)
  entity_type     String   @db.VarChar(100)
  entity_id       String   @db.Uuid
  old_value       Json?
  new_value       Json?
  ip_address      String?  @db.Inet
  user_agent      String?
  result          String   @default("success") @db.VarChar(20) // success, failure
  details         Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations? @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([action], map: "idx_audit_events_action")
  @@index([created_at], map: "idx_audit_events_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_events_entity")
  @@index([organization_id], map: "idx_audit_events_organization")
  @@index([user_id], map: "idx_audit_events_user")
  @@index([organization_id, created_at(sort: Desc)], map: "idx_audit_events_org_created")
}

model background_jobs {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?     @db.Uuid // null for cross-tenant/system jobs
  type            job_type
  payload         Json
  status          job_status? @default(pending)
  priority        Int?        @default(0)
  attempts        Int?        @default(0)
  max_attempts    Int?        @default(3)
  error_message   String?
  run_after       DateTime    @default(now()) @db.Timestamptz(6)
  started_at      DateTime?   @db.Timestamptz(6)
  completed_at    DateTime?   @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)

  organizations organizations? @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([created_at], map: "idx_background_jobs_created_at")
  @@index([priority], map: "idx_background_jobs_priority")
  @@index([status], map: "idx_background_jobs_status")
  @@index([type], map: "idx_background_jobs_type")
  @@index([organization_id], map: "idx_background_jobs_org")
  @@index([status, priority, run_after], map: "idx_background_jobs_queue")
}

model organization_rate_limits {
  // Durable, Postgres-backed rate-limit counters (replaces the previous
  // in-memory-only implementation — see apps/api DECISIONS.md).
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?  @db.Uuid // null for IP-keyed / unauthenticated buckets
  bucket_key      String   @db.VarChar(300) // e.g. "auth:<ip>", "org:<id>:ai_query"
  window_start    DateTime @db.Timestamptz(6)
  window_seconds  Int
  count           Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([bucket_key, window_start])
  @@index([organization_id], map: "idx_rate_limits_org")
  @@index([window_start], map: "idx_rate_limits_window")
}

model form_submissions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id    String   @db.VarChar(50)
  email      String   @db.VarChar(255)
  payload    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_form_submissions_created")
  @@index([email], map: "idx_form_submissions_email")
  @@index([form_id], map: "idx_form_submissions_form_id")
}

model snapshot_requests {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain              String          @db.VarChar(255)
  email               String          @db.VarChar(255)
  status              snapshot_status @default(pending)
  result_json         Json?
  ip_address          String?         @db.Inet
  marketing_consent   Boolean         @default(false)
  converted_to_org_id String?         @db.Uuid
  converted_at        DateTime?       @db.Timestamptz(6)
  expires_at          DateTime        @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)

  organizations organizations? @relation(fields: [converted_to_org_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([domain, created_at(sort: Desc)], map: "idx_snapshot_domain")
  @@index([email], map: "idx_snapshot_email")
  @@index([ip_address, created_at(sort: Desc)], map: "idx_snapshot_ip")
}

// ============================================================================
// PLATFORM REFERENCE DATA (not tenant-scoped — administered by BeBest staff)
// ============================================================================

model ai_providers {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique(map: "ai_providers_name_unique") @db.VarChar(100)
  type       String      @db.VarChar(50)
  config     Json
  is_active  Boolean?    @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  ai_models  ai_models[]

  @@index([is_active], map: "idx_ai_providers_active")
  @@index([type], map: "idx_ai_providers_type")
}

model ai_models {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id     String            @db.Uuid
  name            String            @db.VarChar(100)
  version         String?           @db.VarChar(50)
  capabilities    Json?
  is_active       Boolean?          @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  ai_providers    ai_providers      @relation(fields: [provider_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  evaluation_runs evaluation_runs[]
  runs            runs[]

  @@index([is_active], map: "idx_ai_models_active")
  @@index([provider_id], map: "idx_ai_models_provider")
}

model prompt_templates {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(255)
  description     String?
  category        String            @db.VarChar(50)
  is_active       Boolean?          @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  prompt_versions prompt_versions[]

  @@index([is_active], map: "idx_prompt_templates_active")
  @@index([category], map: "idx_prompt_templates_category")
}

model prompt_versions {
  // Every AI call must reference one of these (ADR-006). `version` is an
  // integer per template; the human-facing string version lives in the
  // AIProvider layer (e.g. "1.2") and is derived from (template, version).
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id       String            @db.Uuid
  version           Int
  content           String
  model             String?           @db.VarChar(100)
  temperature       Decimal?          @default(0.7) @db.Decimal(3, 2)
  max_tokens        Int?              @default(2000)
  is_active         Boolean?          @default(true)
  performance_score Decimal?          @db.Decimal(3, 2)
  deprecated_at     DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  evaluation_runs   evaluation_runs[]
  prompt_templates  prompt_templates  @relation(fields: [template_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([template_id, version], map: "prompt_versions_template_id_version_unique")
  @@index([is_active], map: "idx_prompt_versions_active")
  @@index([template_id], map: "idx_prompt_versions_template")
}

model evaluation_datasets {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(255)
  description      String?
  category         String             @db.VarChar(50)
  question_count   Int?               @default(0)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  evaluation_items evaluation_items[]
  evaluation_runs  evaluation_runs[]

  @@index([category], map: "idx_evaluation_datasets_category")
}

model evaluation_items {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataset_id          String              @db.Uuid
  input_text          String
  expected_output     Json
  difficulty          String?             @default("medium") @db.VarChar(20)
