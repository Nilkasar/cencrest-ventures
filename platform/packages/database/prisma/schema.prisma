// ============================================================================
// CONTENT INTELLIGENCE & GENERATION
// ============================================================================

model content_briefs {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String              @db.Uuid
  brand_id          String              @db.Uuid
  page_id           String?             @db.Uuid
  content_type      String              @db.VarChar(50)
  title             String              @db.VarChar(500)
  target_query      String?
  target_stage      String?             @db.VarChar(50)
  target_intent     String?             @db.VarChar(50)
  keywords          String[]            @default([])
  outline           Json                @default("[]")
  status            String              @default("draft") @db.VarChar(50) // draft, in_review, approved, archived — see checks.sql
  created_by        String?             @db.Uuid // nullable: many briefs are agent-generated, not human-authored
  updated_by        String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?           @db.Timestamptz(6)
  organizations     organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands            brands              @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pages             pages?              @relation(fields: [page_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by_user   users?              @relation("content_briefs_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user   users?              @relation("content_briefs_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  generated_content generated_content[]
  geo_agent_actions geo_agent_actions[]
  seo_agent_actions seo_agent_actions[]
}

model generated_content {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String         @db.Uuid
  brand_id                 String         @db.Uuid
  brief_id                 String         @db.Uuid
  provider_name            String         @db.VarChar(100)
  model_name               String?        @db.VarChar(100)
  content_type             String         @db.VarChar(50)
  title                    String?        @db.VarChar(500)
  body                     String
  word_count               Int?
  ai_readiness_score       Decimal?       @db.Decimal(5, 2)
  entity_count             Int?
  structured_data_included Boolean        @default(false)
  status                   String         @default("draft") @db.VarChar(50) // draft, approved, published, rejected — see checks.sql
  feedback                 Json           @default("{}")
  generated_at             DateTime       @default(now()) @db.Timestamptz(6)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?      @db.Timestamptz(6)
  organizations            organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
