// ============================================================================
// Epic 9 — OPPORTUNITY ENGINE (unified SEO + GEO merge)
// ============================================================================
// The ported `opportunities` model directly above is NOT this epic's table —
// same naming collision, same resolution, as every prior epic that hit one
// (Epic 2's entities/brand_entities, Epic 5's queries vs questions, Epic 7's
// ai_responses/ai_run_responses, Epic 8's geo_gaps left untouched): that
// table keys off `gap_id -> gap_analysis -> intents/analyses`, the LEGACY
// pipeline, and its own field list (`unified_score`, `priority_tier`,
// `action_type`, `expected_impact`...) does not match this epic's literal
// spec field list (`type`, `intent`, `seo_demand_score`, `geo_gap_score`,
// `effort_score`, `impact_score`, `opportunity_score`, `priority`) — not a
// naming quibble, a different table for a different, untouched pipeline.
// Epic 4 hit the identical situation for "opportunities" and resolved it the
// same way, naming its own table `seo_opportunities` — that name is now ALSO
// taken by a real, narrower (SEO-only) table, so this epic's wider merge
// output (SEO-only, GEO-only, AND unified rows) gets its own disambiguated
// name: `unified_opportunities`. See DECISIONS.md's Epic 9 section for the
// full reasoning, and for why `opportunity_evidence` (a genuinely unclaimed
// name) needed no disambiguation at all.
model unified_opportunities {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  // The Epic 5 `queries` row this opportunity's "intent" IS — the epic
  // spec's literal merge key ("for each intent in the brand's Query
  // Universe"). Required + Restrict (not Cascade): same "outlives any one
  // reference" default DECISIONS.md §5 gives `ai_run_responses.query_id`;
  // the unique constraint below also needs a stable, non-null key for
  // idempotent recompute to upsert against.
  query_id String @db.Uuid
  // Snapshotted at write time so the row (and its evidence sentences) stay
  // meaningful even if the query's own text is edited later — same
  // "snapshot, don't re-read live" reasoning as `ai_runs.providers`.
  intent_text String @db.VarChar(1000)

  type unified_opportunity_type

  // 0-100, null when that signal has NO data for this intent at all (never
  // the same as a real 0 — "no keyword matched" vs. "keyword matched, zero
  // volume"). Epic 4's `computeOpportunityScore` "value" output when an SEO
  // signal exists.
  seo_demand_score Decimal? @db.Decimal(5, 2)
  // 0-100, null when there is no GEO gap classification for this intent —
  // Epic 8's `classifyIntentGaps` finding's competitor mention-rate delta
  // when one does exist.
  geo_gap_score Decimal? @db.Decimal(5, 2)

  effort_score            Decimal @db.Decimal(5, 2)
  impact_score            Decimal @db.Decimal(5, 2)
  opportunity_score       Decimal @db.Decimal(5, 2)
  scoring_formula_version String  @default("1.0") @db.VarChar(20)

  // Reuses the identical `opportunity_status` enum every other opportunity
  // table in this schema already uses (`seo_opportunities`, the legacy
  // `opportunities`) — same closed `new|in_progress|completed|dismissed`
  // vocabulary, same DECISIONS.md §6 "don't duplicate a vocabulary that
  // already exists under a generic enough name" precedent.
  status opportunity_status @default(new)
  // 1=high/2=medium/3=low — plain ranking int validated at the API
  // boundary, same precedent as `queries.priority`/`competitors.priority`
  // (DECISIONS.md §15/§16), not a DB enum.
  priority Int @default(2) @db.SmallInt
  // Captured on transition to 'dismissed' (this epic's end-to-end flow step
  // 5: "dismiss with a reason") — same pattern as `deals.lost_reason`.
  dismissal_reason String?

  title String @db.VarChar(255)

  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands               brands                 @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  queries              queries                @relation(fields: [query_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_user      users?                 @relation("unified_opportunities_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  opportunity_evidence opportunity_evidence[]
  // Epic 10 (Recommendation Engine) addition
  opportunity_recommendations opportunity_recommendations[]

  // The idempotency key this epic's DoD explicitly tests: one opportunity
  // row per (brand, intent), ever — `POST .../recompute` always upserts
  // against this, never inserts a second row for the same query.
  @@unique([organization_id, brand_id, query_id], map: "uq_unified_opportunities_brand_query")
  @@index([brand_id], map: "idx_unified_opportunities_brand")
  @@index([status], map: "idx_unified_opportunities_status")
  @@index([type], map: "idx_unified_opportunities_type")
  @@index([organization_id, opportunity_score(sort: Desc)], map: "idx_unified_opportunities_org_score")
}

// Links a `unified_opportunities` row back to the SPECIFIC row(s) that
// justified it — `PRODUCT_VISION.md`'s evidence-sentence example, one
// clause per row. `source_table`/`source_id` is the same open, polymorphic
// reference pattern DECISIONS.md §6 already documents as deliberately
// unconstrained elsewhere (`action_type`, `source`/`source_id` generally) —
// a fixed enum of source tables would have to be widened every time a
// future epic adds a new evidence kind.
model opportunity_evidence {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  opportunity_id  String @db.Uuid
  // 'seo_keywords' | 'ai_runs' (aggregated per-competitor GEO evidence — see
  // `docs/epics/09-opportunity-engine-backend.md` for why not
  // `brand_observations` directly) — open, not enumerated, same reasoning
  // as this model's own header comment.
  source_table String @db.VarChar(50)
  source_id    String @db.Uuid
  // The exact evidence sentence — e.g. "CompetitorA appears in 84% of
  // responses at position 1, you appear in 2% of responses." — never a
  // generic summary (the epic spec's explicit instruction).
  summary  String
  raw_data Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  organizations         organizations         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // True composition child — an evidence row has zero independent meaning
  // once its opportunity is gone (DECISIONS.md §5's Cascade rule).
  unified_opportunities unified_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([opportunity_id], map: "idx_opportunity_evidence_opportunity")
}

// ============================================================================
// Epic 10 — RECOMMENDATION ENGINE (generated action brief from a
// `unified_opportunities` row, per-`action_type` template, SEO+GEO dual
// requirement — see docs/epics/10-recommendation-engine.md)
// ============================================================================
// The legacy `recommendations` model above (in the "GAP / OPPORTUNITY /
// RECOMMENDATION ENGINE" section) is NOT this epic's table — same collision,
// same resolution, as `opportunities`/`unified_opportunities` (DECISIONS.md
// §22): it requires a non-null `analysis_id` into the LEGACY `analyses`
// pipeline and keys off the legacy `opportunities`/`geo_gaps` tables, and its
// column set (`is_recommended`, `rec_type`, `roi_score`, `rec_status`) does
// not match this epic's literal field list (`opportunity_id`, `title`,
// `description`, `action_type`, `effort`, `impact`, `priority_rank`,
// `evidence_summary`, `implementation_notes`, `status`) at all — a different
// table for a different, untouched pipeline, left completely alone. This
// epic's actual table is disambiguated as `opportunity_recommendations`.
model opportunity_recommendations {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  // Denormalized (not read through opportunity_id -> unified_opportunities
  // -> brand_id) so `GET /brands/me/recommendations` never needs a join to
  // scope its list — same "denormalize the tenant/brand key" precedent
  // `unified_opportunities.brand_id` itself already sets (DECISIONS.md §22).
  brand_id String @db.Uuid
  // One recommendation per opportunity, ever — `POST /opportunities/:id/
  // recommendations/generate` upserts against this exactly like `POST
  // .../recompute` upserts unified_opportunities against `query_id` (this
  // epic's spec: "idempotent, same discipline as Epic 9"). Cascade: a
  // recommendation is generated FROM its opportunity's evidence and has no
  // independent meaning without it (same composition-child reasoning as
  // `opportunity_evidence`, DECISIONS.md §5/§22).
  opportunity_id String @db.Uuid

  // create_page | update_page | fix_technical | build_citations — the
  // spec's literal domain-model enum. NOT a reuse of the legacy
  // `action_type` enum (content|seo|pr|product|positioning|technical) —
  // checked directly against schema.prisma before writing this: that
  // enum's vocabulary is a different, coarser taxonomy for a different
  // table and does not contain any of this epic's four literal values.
  action_type recommendation_action_type
  // Reuses `effort_level` (low|medium|high) — already the generic-enough
  // vocabulary the legacy `opportunities.effort_level` column uses
  // (DECISIONS.md §6's "don't duplicate a vocabulary that already exists
  // under a generic enough name"). Reused a second time for `impact` below:
  // the value SET (low/medium/high) is identical for both columns, and
  // Prisma enum type names are independent of the column name that uses
  // them, so defining a second `impact_level` enum with the exact same
  // three values would be the duplication §6 warns against, not this reuse.
  effort effort_level
  impact effort_level

  // Computed from the parent opportunity's `opportunity_score` and this
  // recommendation's own `effort` (this epic's spec, verbatim) — HIGHER
  // ranks first (`GET .../recommendations` orders by this DESC, same
  // convention `opportunity_score` itself already uses), so a cheap
  // (low-effort) recommendation against the same opportunity_score outranks
  // an expensive one. Exact formula + rationale in
  // `apps/api/src/lib/recommendations/generator.ts`'s header comment.
  priority_rank Decimal @db.Decimal(6, 2)

  title String @db.VarChar(500)
  // The specific action, in plain language, grounded in the opportunity's
  // real intent/competitor data — never a rephrasing of the opportunity's
  // own title (this epic's explicit "not a rephrasing" instruction).
  description String
  // Quotes the PARENT opportunity's `opportunity_evidence` rows verbatim
  // (the exact sentences with real numbers already written by Epic 9 —
  // "500 monthly searches," "CompetitorA appears in 84% of responses") —
  // never a generic template string with no real data interpolated (this
  // epic's explicit DoD requirement, end-to-end flow step 1).
  evidence_summary String
  // MUST cover both an SEO requirement (docs/10-seo/SEO_ENGINE.md's Page
  // Analysis Checklist) and a GEO requirement (docs/11-geo/GEO_ENGINE.md's
  // GEO Optimization Principles) for EVERY `action_type` — this epic's DoD
  // calls a recommendation satisfying only one half a spec violation, not a
  // style choice. Plain text (not JSON): the two halves are meant to be
  // read together as one brief, not rendered as separate structured lists.
  implementation_notes String

  // Reuses `opportunity_status` (new|in_progress|completed|dismissed) —
  // same four-state workflow vocabulary `unified_opportunities.status`
  // itself already reuses (DECISIONS.md §22) — rather than a third copy of
  // an identical closed vocabulary for what is functionally the same
  // "open -> in_progress -> completed/dismissed" lifecycle.
  status opportunity_status @default(new)

  // Status transitions are a human action (`PATCH /recommendations/:id`,
  // this epic's spec: "status transitions, audit-logged") — nullable +
  // SetNull, same precedent as `unified_opportunities.updated_by`.
  updated_by String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  organizations         organizations         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                brands                @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unified_opportunities unified_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updated_by_user       users?                @relation("opportunity_recommendations_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Epic 11 (Content Intelligence & Generation) addition — a content brief
  // is generated FROM one approved, content-type recommendation (real FK,
  // not a copy of its fields).
  content_briefs        content_briefs[]
  // Epic 13 (Action Center & Controlled Publishing) addition — an `actions`
  // row may trace back to the recommendation it ultimately came from (real
  // FK, nullable — a Level 1-3 agent-originated action has none).
  actions                actions[]

  // The idempotency key this epic's DoD explicitly tests (step 3: re-run
  // generation, confirm no duplicate row): one recommendation per
  // opportunity, ever.
  @@unique([organization_id, opportunity_id], map: "uq_opportunity_recommendations_opportunity")
  @@index([brand_id], map: "idx_opportunity_recommendations_brand")
  @@index([status], map: "idx_opportunity_recommendations_status")
  @@index([organization_id, brand_id, priority_rank(sort: Desc)], map: "idx_opportunity_recommendations_brand_rank")
}

// ============================================================================
// CONTENT INTELLIGENCE & GENERATION
// ============================================================================

model content_briefs {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  page_id         String? @db.Uuid
  // Epic 11 (Content Intelligence & Generation) addition — this epic's own
  // domain-model requirement ("generated FROM a recommendation, real
  // recommendation_id FK, not a copy"): the SOURCE `opportunity_recommendations`
  // row this brief was generated from. Required (a brief always starts from
  // a recommendation in this epic — there is no other entry point) and
  // Restrict (not Cascade): a brief is a durable artifact of its own once
  // drafts/approvals exist under it; the recommendation being later
  // dismissed/completed must not be able to cascade-delete a brief a human
  // may already be reviewing drafts against.
  recommendation_id String @db.Uuid
  // Denormalized copies of the recommendation's `evidence_summary`/
  // `implementation_notes` AT BRIEF-CREATION TIME — same "snapshot, don't
  // re-read live" reasoning `ai_runs.providers`/`unified_opportunities.intent_text`
  // already use elsewhere in this schema: a later status change or
  // regeneration of the source recommendation must never retroactively
  // change what an already-generated brief says it was built from.
  // `implementation_notes` is what carries the dual SEO+GEO requirement
  // forward verbatim (this epic's end-to-end flow step 1's literal
  // assertion) — never re-summarized/stripped down.
  evidence_summary     String
  implementation_notes String
  // Step 2 of this epic's generation pipeline ("Research evidence and
  // claims — pull from brand_claims [Epic 2], opportunity_evidence [Epic 9]")
  // made visible/auditable rather than silently discarded once the outline
  // is built: `{ brandClaims: [{id, claim, confidence}], opportunityEvidence:
  // [{sourceTable, summary}] }`. See apps/api/src/lib/content/brief-builder.ts.
  research_notes Json @default("{}")
  content_type   String @db.VarChar(50)
  title          String @db.VarChar(500)
  target_query   String?
  target_stage   String?  @db.VarChar(50)
  target_intent  String?  @db.VarChar(50)
  keywords       String[] @default([])
  outline        Json     @default("[]")
  status         String   @default("draft") @db.VarChar(50) // draft, in_review, approved, archived — see checks.sql
  created_by     String?  @db.Uuid // nullable: many briefs are agent-generated, not human-authored
  updated_by     String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  organizations         organizations               @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                brands                      @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pages                 pages?                      @relation(fields: [page_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  opportunity_recommendations opportunity_recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user       users?                      @relation("content_briefs_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user       users?                      @relation("content_briefs_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  generated_content     generated_content[]
  // Epic 11 (Content Intelligence & Generation) addition — see this file's
  // own header comment on `content_drafts` for why this is a NEW table
  // rather than a retrofit of the pre-existing `generated_content` above.
  content_drafts        content_drafts[]
  geo_agent_actions     geo_agent_actions[]
  seo_agent_actions     seo_agent_actions[]

  // One brief per recommendation, ever — same idempotency discipline this
  // epic's own upstream table (`opportunity_recommendations`, §24) and
  // Epic 9's `unified_opportunities` already establish: `POST
  // /recommendations/:id/content-brief` upserts against this key, so a
  // second call updates the existing brief rather than creating a sibling.
  @@unique([organization_id, recommendation_id], map: "uq_content_briefs_recommendation")
  @@index([recommendation_id], map: "idx_content_briefs_recommendation")
  @@index([organization_id, brand_id, status], map: "idx_content_briefs_brand_status")
}

// Epic 11 (Content Intelligence & Generation) — VERSIONED draft content
// (`docs/epics/11-content-intelligence-generation.md`'s literal domain
// model: "content_drafts — generated content versions (plural — regenerating
// creates a new version, never overwrites)").
//
// **Why this is a NEW table, not the pre-existing `generated_content`
// below** (checked directly against schema.prisma first, per the recurring
// "do not guess" rule, per this epic's own task brief: "check schema.prisma
// first, may already have some of this ported"). `generated_content` was
// already ported in Epic 0 from `docs/06-database/SCHEMA.md`'s Content
// section, but its column set has no `version`/`prompt_version` at all —
// retrofitting the versioning this epic's DoD explicitly tests
// ("regenerating creates version 2, version 1 remains readable, never
// overwritten") onto it would be the exact same schema surgery as adding a
// new table, with none of the upside: `generated_content.status`'s existing
// vocabulary (`draft|approved|published|rejected`) already contemplates a
// `'published'` state, which is precisely the ADR-007 boundary this epic
// must never cross (its own DoD: "no code path in this epic calls anything
// resembling a publish action" — a table this epic writes to should not
// even have a `'published'` value in its own vocabulary to accidentally
// reach). `generated_content` is therefore left completely untouched here —
// same "a different, wrong-shaped table for a different concern, left
// alone" resolution DECISIONS.md's §22/§24 already use for `opportunities`/
// `recommendations` — available for whichever future use (Epic 12's agent
// output, most likely) actually wants its current shape.
model content_drafts {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  // Cascade: a draft is generated FROM its brief and has no independent
  // meaning without it — same composition-child reasoning `opportunity_evidence`
  // (DECISIONS.md §5/§22) and `generated_content.brief_id` itself already get.
  brief_id String @db.Uuid
  // 1, 2, 3, ... per `brief_id` — `POST /content-briefs/:id/draft` always
  // INSERTS the next version, never updates an existing row (this epic's
  // explicit "never overwrites" requirement). `@@unique([brief_id, version])`
  // below is both the ordering guarantee and the idempotent-version-number
  // assignment's collision guard.
  version Int
  // ADR-006 evidence-traceability contract, same fields/reasoning
  // `ai_run_responses` already carries for Epic 7's GEO calls — this is
  // "every other AI call in this system" this epic's own end-to-end flow
  // step 2 explicitly requires be true here too. `provider_name`/`model_name`
  // from `CompletionResult.provider`/`.model`; `prompt_version` REQUIRED,
  // never null (`CompletionRequest.promptVersion` is a required field on
  // the `@bebest/ai-provider` contract itself).
  provider_name String @db.VarChar(100)
  model_name    String? @db.VarChar(100)
  prompt_version String @db.VarChar(50)
  title            String? @db.VarChar(500)
  body             String
  meta_description String?
  word_count       Int @default(0)
  // Whether the draft's own body contains schema.org-shaped structured
  // markup guidance (e.g. an explicit FAQ block) — read by the `seo_checklist`
  // quality check (reuses Epic 4's `runContentChecklist`, which expects a
  // `schema_types`-shaped signal) rather than that check re-deriving it.
  structured_data_types String[] @default([])
  // generated | approved — never 'published' in this epic (see this model's
  // header comment); a draft's status only ever reaches "approved, ready to
  // publish," which Epic 13 is what actually acts on. See checks.sql.
  status String @default("generated") @db.VarChar(20)
  // Tracing fields from `CompletionResult`, same as `ai_run_responses`.
  request_id        String? @db.VarChar(100)
  tokens_prompt     Int?
  tokens_completion Int?
  tokens_total      Int?
  latency_ms        Int?
  // Who triggered `POST /content-briefs/:id/draft` — nullable + SetNull,
  // same "no human author for an agent-triggered generation" precedent
  // `content_briefs.created_by` itself already documents. Also this epic's
  // RBAC "editor may approve only a draft they themselves authored" check
  // (`opts.isOwnResource` in `lib/rbac.ts`'s `approve_content`) — see
  // `routes/content-drafts.ts`.
  created_by String? @db.Uuid
  generated_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  organizations          organizations            @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                 brands                   @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  content_briefs         content_briefs           @relation(fields: [brief_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_user        users?                   @relation("content_drafts_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  content_quality_checks content_quality_checks[]
  content_approvals      content_approvals?
  // Epic 13 (Action Center & Controlled Publishing) addition — the real FK
  // Epic 11 -> Epic 13 handoff: an approved draft becomes AT MOST one
  // pending `actions` row (`actions.content_draft_id` is `@unique`), never
  // a re-typed copy. See routes/content-drafts.ts's approve handler.
  actions                actions?

  @@unique([brief_id, version], map: "uq_content_drafts_brief_version")
  @@index([organization_id, brand_id], map: "idx_content_drafts_brand")
}

// Epic 11 addition — every quality check's OWN result, stored individually
// (this epic's explicit DoD: "every check's result stored, not just a
// pass/fail flag... a reviewer approving a draft needs to see what was
// checked, not just that something was"). One row per (draft, check_type)
// per generation — `POST /content-briefs/:id/draft` runs all 5 checks
// (fact_check, brand_voice, duplicate_content, seo_checklist, geo_structure
// — this epic's spec's literal list) and inserts one row each, read back via
// `GET /content-drafts/:id/quality-checks`.
model content_quality_checks {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  // Cascade: a check result has zero independent meaning once its draft is
  // gone — true composition child, same reasoning as `content_drafts.brief_id`.
  draft_id String @db.Uuid
  // fact_check | brand_voice | duplicate_content | seo_checklist |
  // geo_structure — see apps/api/src/lib/content/quality-checks.ts.
  check_type String @db.VarChar(50)
  // pass | fail | warning — see checks.sql.
  status  String   @db.VarChar(20)
  score   Decimal? @db.Decimal(5, 2)
  // The check's own reasoning/evidence (which brand_claims were checked,
  // which crawled page collided, which GEO structuring signals were found,
  // etc.) — never discarded once a status is derived from it.
  details    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  organizations  organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands         brands         @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  content_drafts content_drafts @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([draft_id], map: "idx_content_quality_checks_draft")
}

// Epic 11 addition — the ADR-007 approval gate itself: "who approved, when,
// at what draft version" (this epic's literal domain-model bullet). A
// DEDICATED table, not the pre-existing `publish_jobs` (which already
// exists in this schema, ported in Epic 0 for Epic 13's later publishing
// workflow) — `publish_jobs` bundles the approval fields together with
// `destination`/`published_at`/`published_url`/`publish_log`, i.e. the act
// of publishing itself, which is exactly the surface this epic's DoD
// requires be ABSENT from its own code ("no code path in this epic calls
// anything resembling a publish action... enforced by absence of any
// publish call, not by convention") — writing into a table literally named
// `publish_jobs` from this epic's approve endpoint would blur that boundary
// even though no `destination`/publish field would ever be set. `publish_jobs`
// is left completely untouched; Epic 13 owns it.
model content_approvals {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  // @unique, not just indexed — ONE approval per draft VERSION, ever. A
  // second `POST /content-drafts/:id/approve` on an already-approved draft
  // is idempotent (returns the existing approval, no duplicate row), see
  // `routes/content-drafts.ts`.
  draft_id String @unique @db.Uuid
  // Nullable + SetNull, same convention every other `*_by` actor column in
  // this schema uses (a deleted user must not block reading historical
  // approval records) — the actual authorization check happens at approval
  // TIME in `routes/content-drafts.ts`, this column is the durable record.
  approved_by String? @db.Uuid
  // Snapshot of the approver's role AT APPROVAL TIME — an org can change a
  // member's role later (Epic 0's `membership.role_changed`), which must
  // never retroactively rewrite what role actually authorized a past
  // approval, same "snapshot, don't re-read live" reasoning `content_briefs.
  // evidence_summary` above already documents.
  approved_role String @db.VarChar(50)
  notes         String?
  approved_at   DateTime @default(now()) @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  organizations    organizations   @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands           brands          @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  content_drafts   content_drafts  @relation(fields: [draft_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approved_by_user users?          @relation("content_approvals_approved_by", fields: [approved_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id, brand_id], map: "idx_content_approvals_brand")
}

model generated_content {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String         @db.Uuid
  brand_id                 String         @db.Uuid
  brief_id                 String         @db.Uuid
  provider_name            String         @db.VarChar(100)
  model_name               String?        @db.VarChar(100)
  content_type             String         @db.VarChar(50)
  title                    String?        @db.VarChar(500)
  body                     String
  word_count               Int?
  ai_readiness_score       Decimal?       @db.Decimal(5, 2)
  entity_count             Int?
  structured_data_included Boolean        @default(false)
  status                   String         @default("draft") @db.VarChar(50) // draft, approved, published, rejected — see checks.sql
  feedback                 Json           @default("{}")
  generated_at             DateTime       @default(now()) @db.Timestamptz(6)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?      @db.Timestamptz(6)
  organizations            organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                   brands         @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  content_briefs           content_briefs @relation(fields: [brief_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publish_jobs             publish_jobs[]
}

model publish_jobs {
