// BILLING
// ============================================================================

// Epic 16 (Billing) addition. `docs/06-database/SCHEMA.md` §6's literal DDL
// (repo-root `docs/`, not `platform/docs/` — the epic spec's own path
// reference is one directory off) never had a `plans` table at all — Epic 0
// only ported `subscriptions.plan` as a bare string. This is a genuine new
// table, not a hardening pass, same category as Epic 2's `brand_entities`/
// Epic 7's `ai_runs` additions. Deliberately NOT tenant-scoped (no
// `organization_id`, no RLS) — it is global reference data every org reads
// the same rows from, the identical treatment DECISIONS.md §1 already gives
// `ai_providers`/`ai_models`/`prompt_templates`. See
// `prisma/migrations/0009_billing/rls.sql`'s header for the full reasoning.
model plans {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String    @unique @db.VarChar(50) // free, starter, growth, pro, agency, managed, enterprise — see checks.sql
  name           String    @db.VarChar(100)
  description    String?
  // SCHEMA.md's literal DDL types these as INTEGER (cents), not DECIMAL —
  // kept exactly. Every seeded row's value is NULL: BILLING_ARCHITECTURE.md
  // says outright "Prices are UNDECIDED. Do not implement with fixed
  // prices" — NULL here is a literal instruction from the source doc, not a
  // gap, and applies to all seven tiers, not only the two "custom/contact"
  // ones.
  price_monthly  Int?
  price_yearly   Int?
  currency       String    @default("USD") @db.VarChar(3)
  // Every key from `apps/api/src/lib/entitlements.ts`'s existing
  // `PlanLimits` (Epics 2/5/7's `competitors_tracked`/
  // `queries_per_query_set`/`ai_queries_per_month`) plus every
  // documented-but-not-yet-enforced key from BILLING_ARCHITECTURE.md's
  // "Plan Limits" JSON example (`pages_analyzed`/`snapshots_per_month`/
  // `team_members`/`agents`/`agent_runs_per_month`/`autonomy_level_max`/
  // `white_label`/`client_accounts`) — see `@bebest/database`'s
  // `src/plan-catalog.ts` for the exact seeded shape and the full
  // per-tier-per-key sourcing notes.
  limits         Json      @default("{}")
  // Deliberately an empty object for every seeded row (not populated with
  // invented key names) — no route in this epic or any prior one reads
  // `plans.features` yet; every gating key this epic's own spec names is
  // grouped under `limits` above instead (the epic spec's own literal key
  // list puts `agents`/`white_label` there, not here). Inventing feature
  // flag names nothing reads would be exactly the kind of unfounded guess
  // DECISIONS.md's "deliberately not constrained" philosophy (§6) warns
  // against — left for whichever future epic (12+) defines real ones.
  features       Json      @default("{}")
  active         Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  subscriptions subscriptions[]

  @@index([active], map: "idx_plans_active")
}

model subscriptions {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String              @unique @db.Uuid
  // NOT NULL, matching SCHEMA.md's literal DDL exactly — every org's
  // subscription always resolves to a real `plans` row (bootstrapped to the
  // seeded `free` plan's id at org-creation time; see
  // `apps/api/src/routes/orgs.ts`).
  plan_id               String              @db.Uuid
  // Denormalized cache of `plans.slug`, kept in sync by application code on
  // every `plan_id` change (see `apps/api/src/lib/billing/subscriptions.ts`).
  // NOT in SCHEMA.md's literal DDL — the one deliberate addition beyond it,
  // kept specifically so `apps/api/src/lib/entitlements.ts`'s pre-existing
  // `chk_subscriptions_plan`-constrained bare-string read path (and its
  // already-VERIFIED Epic 2/5/7 regression tests, which mock exactly that
  // shape) keeps working unmodified even once `plan_id`/`plans` is the real
  // source of truth. See entitlements.ts's own header comment for the full
  // "why two columns, and why that isn't drift" reasoning.
  plan                  String              @default("free") @db.VarChar(50)
  // Renamed from `stripe_customer_id`/`stripe_subscription_id` — provider-
  // agnostic per the `PaymentProvider` abstraction (BILLING_ARCHITECTURE.md
  // principle #4: "switching from Stripe to Paddle requires changing one
  // adapter"). `external_customer_id` is additive beyond SCHEMA.md's literal
  // DDL (that DDL has no customer-id column on `subscriptions` at all) —
  // needed because `PaymentProvider.createCustomer` returns an id this table
  // is the natural place to persist. `external_id` matches SCHEMA.md's
  // literal field name exactly (the renamed Stripe *subscription* id).
  external_customer_id String?             @unique @db.VarChar(255)
  external_id           String?            @unique @db.VarChar(255)
  status                subscription_status @default(active)
  // Kept nullable (SCHEMA.md's literal DDL has these NOT NULL) — a brand
  // new free-tier subscription bootstrapped at org-creation time has no
  // real billing period yet; forcing a fake date here would be worse than
  // leaving it null until a real `PaymentProvider.createSubscription` call
  // sets it, same "don't fabricate a value nothing produced yet" instinct
  // DECISIONS.md applies throughout.
  current_period_start  DateTime?           @db.Timestamptz(6)
  current_period_end    DateTime?           @db.Timestamptz(6)
  trial_ends_at         DateTime?           @db.Timestamptz(6)
  cancelled_at          DateTime?           @db.Timestamptz(6)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @db.Timestamptz(6)
  organizations         organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plans                 plans               @relation(fields: [plan_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organization_id], map: "idx_subscriptions_org")
  @@index([plan_id], map: "idx_subscriptions_plan_id")
}

// Epic 16 (Billing) addition — genuinely new table, no prior-epic
// equivalent. Required by the epic spec's own literal idempotency
// requirement ("a replayed webhook must not double-apply an effect — dedupe
// by event ID"), which needs somewhere durable to record "this external
// event id has already been processed" that survives past a single request.
// Deliberately NOT RLS-protected: a webhook arrives knowing only an
// external customer/subscription id, not an `organization_id` — there is no
// tenant context to set before the very first lookup that resolves one,
// the identical situation DECISIONS.md §7b documents for `invitations`.
// `organization_id` is nullable for the same reason (resolved AFTER the
// signature is verified and the payload is parsed, not before).
model billing_webhook_events {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_event_id  String    @unique @db.VarChar(255)
  event_type         String    @db.VarChar(100)
  organization_id    String?   @db.Uuid
  payload            Json
  processed_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  organizations      organizations? @relation(fields: [organization_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id], map: "idx_billing_webhook_events_org")
}

model usage_records {
