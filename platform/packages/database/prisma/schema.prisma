// ============================================================================
// WEBSITE INTELLIGENCE (crawler)
// ============================================================================

// Epic 3 (Website Intelligence) fix-forward on the ported `crawl_jobs`
// model — docs/epics/03-website-intelligence.md's literal field list is
// `id, organization_id, brand_id, root_url, status, pages_crawled,
// pages_failed, started_at, completed_at, error`. The ported model was
// missing `root_url` entirely (there was no way to record WHICH URL a job
// actually crawled — a genuine gap, not a naming quibble, since brands.website_url
// can change after a job starts) and `pages_failed` (only `pages_found`
// existed, which is progress-toward-total, not error count). Both added.
// `error_message`/`pages_found` are kept ADDITIVELY alongside the spec's
// `error`/`pages_failed` names rather than dropped, because they carry
// distinct meaning `error` doesn't fully cover on their own... except
// `error_message` really is just `error` under a different name with no
// other reader, so it's renamed outright (see below); `pages_found` (total
// links discovered, independent of pages_failed) is kept as a genuinely
// useful additional counter for progress-percentage math, not a spec
// deviation.
model crawl_jobs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  // The URL actually crawled, captured at job-creation time (usually
  // brands.website_url, but recorded independently so a later brand-profile
  // edit can never rewrite what an already-completed job says it crawled).
  root_url        String        @db.VarChar(2048)
  status          crawl_status  @default(queued)
  pages_crawled   Int           @default(0)
  pages_found     Int           @default(0)
  pages_failed    Int           @default(0)
  error           String?
  started_at      DateTime?     @db.Timestamptz(6)
  completed_at    DateTime?     @db.Timestamptz(6)
  // Nullable, human-triggered (the crawl button), SetNull on user deletion —
  // same "required attribution, not required data" reasoning as
  // DECISIONS.md §4's other created_by columns. No `updated_by`: once
  // queued, every further status transition (running/completed/failed) is
  // made by the crawl pipeline itself, not a human edit.
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user users?        @relation("crawl_jobs_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pages           pages[]

  @@index([brand_id], map: "idx_crawl_jobs_brand")
  @@index([status], map: "idx_crawl_jobs_status")
  @@index([organization_id], map: "idx_crawl_jobs_org")
}

model pages {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String            @db.Uuid
  crawl_job_id     String            @db.Uuid
  brand_id         String            @db.Uuid
  url              String            @db.VarChar(2048)
  title            String?           @db.VarChar(500)
  meta_description String?
  h1               String?           @db.VarChar(500)
  // Renamed from `canonical` to `canonical_url` — matches
  // docs/epics/03-website-intelligence.md's literal field name.
  canonical_url    String?           @db.VarChar(2048)
  status_code      Int?
  word_count       Int               @default(0)
  load_ms          Int?
  internal_links   Int               @default(0)
  external_links   Int               @default(0)
  // `schema_types` (which schema.org @types were found) is kept ADDITIVELY
  // instead of the spec's flat `has_schema_markup` boolean — a denormalized
  // boolean that only ever equals `schema_types.length > 0` would just be a
  // column that can drift from the truth; the API serializer computes
  // `hasSchemaMarkup` from this array instead. See
  // docs/epics/03-website-intelligence-backend.md.
  schema_types     String[]          @default([])
  // SHA-256 hex digest of the sanitized page content, for the spec's
  // "raw_html_hash (dedupe)" requirement — named `raw_html_hash` per the
  // spec's literal field name even though what's hashed is the sanitized
  // extracted text, never the raw HTML itself (see
  // docs/epics/03-website-intelligence-backend.md's "sanitize before
  // storage" note for why raw HTML is never persisted at all).
  raw_html_hash    String?           @db.VarChar(64)
  crawled_at       DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?         @db.Timestamptz(6)
  content_analyses content_analyses?
  content_briefs   content_briefs[]
  page_issues      page_issues[]
  // Epic 4 (SEO Intelligence) addition — nullable on seo_analyses (SetNull),
  // so no `?` needed here even though a page can have zero or many.
  seo_analyses     seo_analyses[]
  organizations    organizations     @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands           brands            @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  crawl_jobs       crawl_jobs        @relation(fields: [crawl_job_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([brand_id], map: "idx_pages_brand")
  @@index([crawl_job_id], map: "idx_pages_crawl_job")
  @@index([raw_html_hash], map: "idx_pages_raw_html_hash")
}

model page_issues {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  brand_id        String         @db.Uuid
  page_id         String         @db.Uuid
  issue_type      issue_type
  severity        issue_severity
  detail          String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands         @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pages           pages          @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([page_id], map: "idx_page_issues_page")
  @@index([brand_id, severity], map: "idx_page_issues_brand_severity")
}

// New table (didn't exist under any name in the ported schema) — the
// spec's fourth Website Intelligence table:
// `sitemaps — id, brand_id, organization_id, url, url_count,
// last_fetched_at`. Modeled as an upsert-per-URL reference record (unique
// on brand_id+url), not an append-only history row per fetch — a sitemap
// URL's row is what "the last time we looked, this sitemap had N URLs"
// means; unlike `crawl_jobs`, the spec's End-to-end-flow item 5
// ("re-crawl... history preserved") is stated for crawl jobs specifically,
// not sitemaps. No created_by/updated_by: discovered and refreshed by the
// crawler itself (checking robots.txt / the default /sitemap.xml path),
// not a human-authored row — same reasoning as DECISIONS.md §4's
// "pipeline tables" list. No deleted_at: if a sitemap disappears from a
// site the next crawl simply stops refreshing `last_fetched_at` for it;
// nothing here is user-managed data that needs an undo.
model sitemaps {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  url             String        @db.VarChar(2048)
  url_count       Int?
  last_fetched_at DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([brand_id, url])
  @@index([organization_id], map: "idx_sitemaps_org")
}

model content_analyses {
  id                              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                 String        @db.Uuid
  page_id                         String        @unique @db.Uuid
  brand_id                        String        @db.Uuid
  ai_readiness_score              Decimal?      @db.Decimal(5, 2)
  thin_content_flag               Boolean       @default(false)
  topic_coverage_score            Decimal?      @db.Decimal(5, 2)
  structured_data_present         Boolean       @default(false)
  word_count                      Int?
  reading_level                   String?       @db.VarChar(50)
  entity_density                  Decimal?      @db.Decimal(5, 4)
  citations_found_in_ai_responses Int           @default(0)
  gap_types                       String[]      @default([])
  improvement_suggestions         Json          @default("[]")
  analyzed_at                     DateTime      @default(now()) @db.Timestamptz(6)
  created_at                      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime      @default(now()) @db.Timestamptz(6)
  organizations                   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pages                           pages         @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// ============================================================================
// SEO INTELLIGENCE
// ============================================================================

/// This table has a CHECK constraint (see checks.sql) requiring `volume >= 0`
/// and `difficulty BETWEEN 0 AND 100` when present.
model keywords {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                   @db.Uuid
  brand_id               String                   @db.Uuid
  keyword                String                   @db.VarChar(500)
  volume                 Int?
  difficulty             Int?                     @db.SmallInt
  cpc                    Decimal?                 @db.Decimal(8, 2)
  intent                 keyword_intent?
  source                 keyword_source           @default(manual)
  created_by             String?                  @db.Uuid
  updated_by             String?                  @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at             DateTime?                @db.Timestamptz(6)
  brand_keyword_rankings brand_keyword_rankings[]
  organizations          organizations            @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                 brands                   @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user        users?                   @relation("keywords_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user        users?                   @relation("keywords_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  seo_agent_actions      seo_agent_actions[]

  @@unique([brand_id, keyword])
  @@index([brand_id], map: "idx_keywords_brand")
}

model keyword_clusters {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  cluster_name    String        @db.VarChar(255)
  pillar_topic    String?       @db.VarChar(255)
  keyword_ids     String[]      @default([]) @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([brand_id], map: "idx_clusters_brand")
}

model brand_keyword_rankings {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  keyword_id      String        @db.Uuid
  position        Int?          @db.SmallInt
  url             String?       @db.VarChar(2048)
  date            DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  clicks          Int?
  impressions     Int?
  ctr             Decimal?      @db.Decimal(5, 4)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  keywords        keywords      @relation(fields: [keyword_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([keyword_id, date])
  @@index([brand_id], map: "idx_rankings_brand")
  @@index([keyword_id], map: "idx_rankings_keyword")
}

model gsc_connections {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String        @db.Uuid
  brand_id          String        @unique @db.Uuid
  site_url          String        @db.VarChar(500)
  access_token_enc  String
  refresh_token_enc String
  token_expires_at  DateTime?     @db.Timestamptz(6)
  last_imported_at  DateTime?     @db.Timestamptz(6)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @db.Timestamptz(6)
  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands            brands        @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// ── Epic 4 (SEO Intelligence) additions ─────────────────────────────────────
// docs/epics/04-seo-intelligence.md's domain model section is explicit that
// docs/06-database/SCHEMA.md never gave `keyword_groups`/`keywords`/
// `seo_analyses`/`seo_opportunities` their own `CREATE TABLE` statements the
// way it did for Identity/Brand/GEO/Opportunity/CRM/Billing — "define them
// now." Same discipline as every other epic's schema-gap section in this
// file (§13/§14/§16/§17 in DECISIONS.md): additive only, `prisma validate`/
// `generate` only, nothing applied to a database.
//
// **`keywords` naming collision, resolved the same way Epic 5 resolved
// `queries` vs. the ported `questions`/`query_set_questions` pair (see the
// "QUERY UNIVERSE" section below and DECISIONS.md §16):** the ported schema
// already has a `keywords` model (directly above, under "SEO INTELLIGENCE")
// — `brand_id`-scoped, `keyword` (not `text`), no `confidence` field, no
// `keyword_group_id` — built for the not-yet-implemented autonomous SEO
// agent pipeline (`seo_agent_actions.keyword_id -> keywords`,
// `brand_keyword_rankings`, `keyword_clusters`). Nothing in `apps/api`
// consumes that table today (grep confirms zero route references), so it is
// left untouched for whichever future epic builds that agent, per §12's
// "harden, don't redesign" rule — repurposing it would mean either breaking
// its already-modeled `seo_agent_actions`/`brand_keyword_rankings` shape or
// smuggling a second, incompatible meaning onto the same table name. The
// epic's literal `KeywordData` shape (`docs/10-seo/SEO_ENGINE.md`) is
// implemented here as `seo_keywords` instead — a genuinely new table, not a
// reuse — with `keyword_groups` (also new) as its one-to-many parent.
//
// Two existing enums are reused as-is (exact value match, no need to
// duplicate): `keyword_intent` (`informational|navigational|commercial|
// transactional` — matches the epic's literal intent list) for
// `seo_keywords.intent`, and `opportunity_status` (`new|in_progress|
// completed|dismissed`) for `seo_opportunities.status` — the API surface's
// "list, get, dismiss" maps directly onto that enum's existing values, and
// Epic 9's future unified Opportunity Engine table (which this one is
// deliberately kept close to, per the epic spec) will want the same status
// vocabulary anyway.
//
// `seo_keyword_confidence` (`high|medium|low|estimate`) is a NEW enum, not
// a reuse of `claim_confidence` (`high|medium|low`, no `estimate` value) —
// different concept (a brand-claim's evidential confidence vs. a keyword
// metric's data-quality confidence) that only coincidentally shares three
// of four values; forcing the reuse would mean either adding `estimate` to
// `claim_confidence` for a domain it has nothing to do with, or leaving this
// table unable to express the one value the epic spec's step 2 explicitly
// requires ("never silently presenting an estimate as a firm number").
//
// `seo_provider_source` is a NEW enum naming the concrete `SEODataProvider`
// implementations this epic's abstraction can be backed by (see
// `apps/api/src/lib/seo/seo-data-provider.ts`) — `null_provider` is the only
// one actually wired (`NullSEODataProvider`); `search_console` names the
// pre-existing, unused `gsc_connections` OAuth-token table above as the
// natural first real provider a future epic would implement; `dataforseo`/
// `semrush`/`ahrefs`/`serper` are the four paid vendors the epic spec names
// as "not wired yet." Closed enum (not the open-VARCHAR treatment
// `queries.category` got) because this is a fixed, code-defined set of
// integrations, not an open user-facing taxonomy — same reasoning as the
// legacy `keyword_source` enum immediately above this block, which this
// deliberately does NOT reuse (that enum's values — `manual`/`csv_import`/
// `gsc` — describe how a legacy row was IMPORTED, a different axis from
// "which live SEODataProvider implementation answered this call").
//
// `seo_opportunities.opportunity_type` stays an open, unconstrained
// `VARCHAR` — the spec's own literal list ends in "..." (`service_page |
// comparison_page | use_case_page | faq_page | ...`), an explicit signal
// this is an extensible taxonomy, not a closed one — same "deliberately not
// constrained" treatment DECISIONS.md §6 and the `queries.category` epic-5
// precedent give every other open-ended classification column in this
// schema. The formula's raw inputs (`demand_score`, `current_coverage`,
// `content_complexity`, `technical_difficulty`) are likewise not their own
// columns — they live inside `evidence` (JSONB), mirroring the legacy
// `opportunities.evidence` column exactly (the epic spec: "keep the shape
// close to the opportunities table Epic 9 will define") and satisfying the
// UI surface's evidence-traceability requirement ("each opportunity shows
// its evidence... not just a bare number") without inventing four columns
// nothing outside this JSON blob needs to query on independently.
model keyword_groups {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  brand_id        String    @db.Uuid
  name            String    @db.VarChar(255)
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands         @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user users?         @relation("keyword_groups_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user users?         @relation("keyword_groups_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  seo_keywords    seo_keywords[]

  @@index([brand_id], map: "idx_keyword_groups_brand")
  @@index([organization_id], map: "idx_keyword_groups_org")
}

/// The epic's literal `keywords` table (see the comment block above this
/// section for why it is named `seo_keywords` at the Prisma/table level).
/// Mirrors `docs/10-seo/SEO_ENGINE.md`'s `KeywordData` shape exactly: `text`
/// (not `keyword` — the legacy table's name, deliberately not matched),
/// `intent`, `monthly_volume`, `difficulty`, `confidence`, `source`. Scoped
/// by `keyword_group_id` only (plus the denormalized `organization_id` for
/// RLS) — no direct `brand_id` column — same "child hangs off its direct
/// one-to-many parent, not re-denormalized past it" shape `queries` uses
/// relative to `query_sets`. This table has a CHECK constraint (see
/// `prisma/migrations/0007_seo_intelligence/checks.sql`) requiring
/// `monthly_volume >= 0` and `difficulty BETWEEN 0 AND 100` when present —
/// same pair of checks the legacy `keywords` table already has.
model seo_keywords {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String                  @db.Uuid
  keyword_group_id String                 @db.Uuid
  text            String                  @db.VarChar(500)
  intent          keyword_intent?
  monthly_volume  Int?
  difficulty      Int?                    @db.SmallInt
  confidence      seo_keyword_confidence  @default(estimate)
  source          seo_provider_source     @default(null_provider)
  created_by      String?                 @db.Uuid
  updated_by      String?                 @db.Uuid
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?               @db.Timestamptz(6)

  organizations     organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  keyword_groups    keyword_groups      @relation(fields: [keyword_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_user   users?              @relation("seo_keywords_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user   users?              @relation("seo_keywords_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  seo_opportunities seo_opportunities[]

  @@unique([keyword_group_id, text])
  @@index([keyword_group_id], map: "idx_seo_keywords_group")
  @@index([organization_id], map: "idx_seo_keywords_org")
}

/// Technical/content SEO checklist results for a crawled page (Epic 3's
/// `pages`) or, for `analysis_type = content`, a brand-level pass with no
/// single page (`page_id` nullable). Append-only pipeline output — no
/// `deleted_at`/`created_by` (DECISIONS.md §3/§4's "immutable pipeline
/// output" rule, same treatment as `content_analyses`/`analyses` above),
/// `analyzed_at` is the row's one meaningful timestamp. `findings` (JSONB)
/// holds the full per-check checklist result
/// (`{ checks: [{ id, passed, severity, detail }], ... }`) — see
/// `apps/api/src/lib/seo/technical-checklist.ts` for the exact shape;
/// `page_issues` rows are the normalized, queryable projection of the
/// `passed: false` entries onto Epic 3's own table (the epic spec's literal
/// requirement: "writes seo_analyses + derives page_issues where
/// applicable").
model seo_analyses {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  brand_id        String            @db.Uuid
  page_id         String?           @db.Uuid
  analysis_type   seo_analysis_type
  score           Int
  findings        Json
  analyzed_at     DateTime          @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands        brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pages         pages?        @relation(fields: [page_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id], map: "idx_seo_analyses_brand")
  @@index([organization_id], map: "idx_seo_analyses_org")
  @@index([page_id], map: "idx_seo_analyses_page")
}

/// Formula v1.0 (`docs/10-seo/SEO_ENGINE.md`, verbatim): `Value = demand ×
/// (1 - coverage)`, `Effort = content_complexity × technical_difficulty`,
/// `Score = Value×0.7 + (Value/Effort)×0.3`, all normalized 0-100. See
/// `apps/api/src/lib/seo/opportunity-scoring.ts` for the implementation and
/// its unit tests. `scoring_formula_version` is stored per-row (not read
/// from a global constant) so a future v1.1 can be introduced without
/// silently reinterpreting already-computed historical rows.
model seo_opportunities {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String             @db.Uuid
  brand_id                String             @db.Uuid
  keyword_id              String?            @db.Uuid
  title                   String             @db.VarChar(255)
  // service_page | comparison_page | use_case_page | faq_page | ... —
  // deliberately open, see the comment block above this section.
  opportunity_type        String             @db.VarChar(50)
  value_score             Decimal            @db.Decimal(5, 2)
  effort_score            Decimal            @db.Decimal(5, 2)
  opportunity_score       Decimal            @db.Decimal(5, 2)
  scoring_formula_version String             @default("1.0") @db.VarChar(20)
  status                  opportunity_status @default(new)
  // { demandScore, currentCoverage, contentComplexity, technicalDifficulty }
  // — the formula's raw inputs, so the UI can show its work instead of a
  // bare number (evidence-traceability principle, see comment block above).
  evidence                Json?
  updated_by              String?            @db.Uuid
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)

  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  seo_keywords    seo_keywords? @relation(fields: [keyword_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user users?        @relation("seo_opportunities_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id], map: "idx_seo_opportunities_brand")
  @@index([keyword_id], map: "idx_seo_opportunities_keyword")
  @@index([organization_id, opportunity_score(sort: Desc)], map: "idx_seo_opportunities_org_score")
}

// ============================================================================
// QUERY UNIVERSE / QUESTIONS
// ============================================================================

// ── Epic 5 (Intent & Query Universe) additions ──────────────────────────────
// docs/epics/05-intent-query-universe.md's domain model section points at
// docs/06-database/SCHEMA.md §3's literal `query_sets`/`queries` DDL. The
// ported schema already had a `query_sets` table, but it was missing three
// fields that DDL requires (`query_count`, `version`, `status`) — added
// below, following the "audit against the epic spec, fix forward" rule this
// package has used throughout (see DECISIONS.md §13/§15).
//
// The ported schema's existing `questions`/`query_set_questions` pair is
// NOT reused for the epic's `queries` concept, even though the names are
// close. That pair is a many-to-many join (a `question` can belong to
// several `query_sets`) built for the legacy `questions -> runs ->
// responses` AI pipeline, with no `intent_type`/`category`/`tags`/
// `priority` fields at all — none of which this epic's template generator
// or its "group by the ten categories" review UI can work without. Epic
// 7's own spec (docs/epics/07-ai-visibility-engine.md) independently
// confirms this split: it defines brand-new `ai_runs`/`ai_responses`
// tables (not the legacy `runs`/`responses`) that consume a query_set's
// `queries` directly — so `questions`/`query_set_questions`/`runs`/
// `responses` are left untouched, exactly as `entities` was left untouched
// when `brand_entities` was added in Epic 2 (see DECISIONS.md §12/§13).
// `queries.query_set_id` is a direct one-to-many FK (not a join table) per
// the DDL's literal `query_set_id UUID NOT NULL REFERENCES query_sets(id)`.
model query_sets {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  brand_id        String    @db.Uuid
  name            String    @db.VarChar(255)
  description     String?
  // Denormalized count of this set's non-deleted `queries` rows — kept in
  // sync by apps/api on every generate/add/remove (see
  // docs/epics/05-intent-query-universe-backend.md), not a computed column,
  // matching the literal DDL (`query_count INTEGER NOT NULL DEFAULT 0`).
  query_count Int @default(0)
  // Frozen at `activate` time (draft -> active): docs/epics/
  // 05-intent-query-universe.md step 4 requires that a subsequent edit "must
  // not silently mutate the same version other epics may already be
  // referencing." apps/api enforces this by rejecting queries mutations
  // once status != 'draft' — see routes/query-sets.ts.
  version Int @default(1)
  // draft | active | archived — literal DDL is VARCHAR+comment, not a native
  // enum (matches the `subscriptions.plan` precedent: closed vocabulary,
  // CHECK constraint in prisma/migrations/0004_query_universe/checks.sql,
  // not a Postgres ENUM type). See DECISIONS.md §6 for why closed VARCHARs
  // get a CHECK instead of a native enum in this schema.
  status              String                @default("draft") @db.VarChar(50)
  // Post-verification fix (Epic 5 QA pass — see DECISIONS.md §18 and
  // docs/epics/05-intent-query-universe-backend.md's "Post-verification
  // fixes"): the frontend's `QuerySet` type needs these five fields for real
  // UI surfaces (the cap meter and "why 500 and not more" copy on
  // `QuerySetSummaryCard`, the "Activated"/"Archived" timestamps shown
  // there and in the version-history table) — none of it was persisted
  // before. `plan_tier`/`plan_limit`/`potential_count` are frozen at
  // `generate` time (not re-read from `subscriptions` on every request) so
  // the explanation stays correct even after the org's plan later changes;
  // `activated_at`/`archived_at` are set by the `activate`/`archive` routes.
  plan_tier       String    @default("free") @db.VarChar(50)
  // The cap actually applied at generation time. For a plan with no
  // configured cap (`queries_per_query_set: null` — agency/managed, see
  // apps/api/src/lib/entitlements.ts), this is set to `potential_count`
  // (nothing was truncated), not a sentinel — the frontend type has no
  // "unlimited" representation, so "the limit that bound" and "how many
  // exist" are simply equal when no cap actually applied.
  plan_limit      Int       @default(0)
  // The uncapped candidate count the brand profile could have produced —
  // lets the UI say "500 of 812 possible" only when the cap actually bound.
  potential_count Int       @default(0)
  activated_at    DateTime? @db.Timestamptz(6)
  archived_at     DateTime? @db.Timestamptz(6)
  created_by          String                @db.Uuid
  updated_by          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  query_set_questions query_set_questions[] @ignore
  queries             queries[]
  // Epic 7 (AI Visibility Engine) addition — a query_set's `active` version
  // is what `POST /brands/:id/ai-runs` consumes; see the "AI VISIBILITY
  // ENGINE" section below.
  ai_runs             ai_runs[]
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands              brands                @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user     users                 @relation("query_sets_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_user     users?                @relation("query_sets_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id], map: "idx_query_sets_brand")
  // Pre-existing gap fixed while touching this table for this epic: every
  // OTHER `organization_id` column added by Epic 0's hardening pass got its
  // own index (DECISIONS.md §1/§11 — required for RLS policy evaluation to
  // use an index scan); this table's was missing one.
  @@index([organization_id], map: "idx_query_sets_organization")
  @@index([status], map: "idx_query_sets_status")
  // Post-verification fix: the single-active-query-set enforcement added to
  // `PATCH /:id/activate` (docs/epics/05-intent-query-universe-backend.md)
  // queries "every OTHER active query_set for this brand" — a composite
  // index on the exact predicate that query filters by, not just the two
  // single-column indexes above.
  @@index([brand_id, status], map: "idx_query_sets_brand_status")
}

/// The ten query-generation categories the template generator produces
/// (docs/11-geo/GEO_ENGINE.md's "Query Categories" list, verbatim), plus the
/// four buyer-intent classifications (docs/06-database/SCHEMA.md §3's
/// `queries.intent_type` column comment) a human can also assign when
/// manually adding a query. `priority` (1=high/2=medium/3=low) deliberately
/// has NO db-level CHECK — same precedent as `competitors.priority`
/// (DECISIONS.md §15): a plain ranking int, validated by Zod at the API
/// boundary, not a closed taxonomy.
model queries {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  query_set_id    String    @db.Uuid
  text            String
  // informational | commercial | comparison | transactional. Nullable at the
  // DB layer (kept open for a future direct-write path this epic doesn't
  // have), but the frontend's `Query.intentType` is non-nullable — Post-
  // verification fix: both write routes in `routes/query-sets.ts` now
  // guarantee a non-null value at the API boundary instead (`generate`
  // always sets it from the template's category mapping; manual add derives
  // it from the chosen category via `query-generator.ts`'s `CATEGORY_META`
  // when the caller doesn't supply one), so nullability is enforced by
  // application logic, not narrowed at the schema/CHECK level. See
  // DECISIONS.md §18.
  intent_type String? @db.VarChar(50)
  // category | problem | commercial | comparison | feature | industry |
  // size | geography | intent | authority — the ten template categories;
  // this is what the review UI groups by (epic spec's "UI surface" section).
  // Same nullability reconciliation as `intent_type` above: nullable here,
  // but `routes/query-sets.ts`'s manual-add Zod schema now requires it on
  // every write, matching the frontend's non-nullable `Query.category`.
  // Deliberately still an open `VARCHAR`, not narrowed to the ten template
  // values — see the CHECK-constraints note above this model for why.
  category  String?  @db.VarChar(100)
  tags      String[] @default([])
  priority  Int      @default(2) @db.SmallInt
  // Post-verification fix (Epic 5 QA pass, DECISIONS.md §18): the frontend's
  // `Query.source` field ("generated" vs "manual") is genuinely displayed —
  // a "Manual" badge in the review UI distinguishing what a human curated
  // from what the template generator produced — so it gets a real column
  // instead of being dropped. Set once at creation by
  // `apps/api/src/routes/query-sets.ts` (`generate` writes `'generated'`,
  // the manual-add route writes `'manual'`); never changes after.
  source          String    @default("generated") @db.VarChar(20)
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Cascade: a query has zero independent meaning once its query_set is
  // gone — true composition child, same rule as `query_set_questions`
  // (DECISIONS.md §5).
  query_sets      query_sets @relation(fields: [query_set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_user users?     @relation("queries_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updated_by_user users?     @relation("queries_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Epic 7 (AI Visibility Engine) additions — a query is executed against
  // every configured provider once per `ai_runs` run.
  ai_run_responses   ai_run_responses[]
  brand_observations brand_observations[]
  // Epic 9 (Opportunity Engine) addition — the merge's per-intent key.
  unified_opportunities unified_opportunities[]

  @@index([query_set_id], map: "idx_queries_query_set")
  @@index([organization_id], map: "idx_queries_organization")
  @@index([category], map: "idx_queries_category")
  @@index([intent_type], map: "idx_queries_intent_type")
}

// ============================================================================
// AI VISIBILITY ENGINE (Epic 7 — GEO core)
// ============================================================================

// docs/epics/07-ai-visibility-engine.md's domain model calls for brand-new
// `ai_runs`/`ai_responses`/`brand_observations` tables, explicitly NOT the
// legacy `runs`/`responses`/`prompt_jobs`/`ai_responses` pipeline above
// (`questions -> prompt_jobs -> ai_responses`, tied to `buyer_journeys`) —
// see the comment block above the `queries` model (Epic 5) for the same
// "new tables, old ones left untouched" reasoning, which this epic's own
// spec text independently confirms.
//
// **Naming deviation from the spec's literal table name.** The spec calls
// the per-(query x provider) response table `ai_responses` — but that name
// is ALREADY TAKEN by the legacy model directly above (`model ai_responses`,
// FK'd from `prompt_jobs`/`citations`/`mention_extractions`), a genuine
// Prisma model-name collision, not a naming quibble. Same situation as
// Epic 2's `entities`/`brand_entities` split (DECISIONS.md §12/§13): the
// OLD table is left completely alone (it's still load-bearing for the
// legacy pipeline's own FKs), and THIS epic's table gets a disambiguating
// name — `ai_run_responses` — instead of colliding with it. See
// DECISIONS.md's Epic 7 section for the full reasoning.
model ai_runs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  brand_id        String   @db.Uuid
  query_set_id    String   @db.Uuid
  // Epic 8 (Competitive Intelligence) addition. NULL = this run measures
  // "our" brand (Epic 7's original, unmodified case). Non-null = this run
  // reuses the IDENTICAL pipeline (`apps/api/src/lib/ai-visibility/
  // pipeline.ts`) pointed at one `competitors` row instead of `brands` —
  // same query_set, same providers, same extraction schema, only the
  // tracked entity's name/aliases fed into the extraction prompt differ.
  // Checked first per this epic's brief: the Epic 0 ported schema's
  // `competitor_mentions`/`competitor_visibility`/`geo_gaps` tables already
  // model a brand-vs-competitor comparison, but all three key off the
  // LEGACY `analyses`/`prompt_runs` pipeline (see the "AI RUNS / RESPONSES
  // (legacy...)" section below and DECISIONS.md §19's `ai_responses` naming
  // note) — not `ai_runs`. Adding a column here (rather than repurposing
  // those legacy tables) is the same "new epic, new pipeline, old tables
  // left completely alone" precedent §19 itself already established.
  // `brand_id` above stays REQUIRED even on a competitor run: it is the
  // org's own brand this competitor is being measured against, i.e. every
  // row (competitor run or not) is still "this brand's data" for RLS/
  // scoping purposes — `competitor_id` is additive context, not a
  // replacement for `brand_id`.
  competitor_id String? @db.Uuid
  // The resolved provider name list this run actually fanned out to
  // (docs/12-ai/AI_ARCHITECTURE.md's `taskDefaults['geo.query']` —
  // openai/anthropic/google/perplexity), snapshotted at PREPARE time so a
  // later change to the routing table never retroactively rewrites what a
  // historical run claims it queried.
  providers String[] @default([])
  // queued | running | completed | failed — same VARCHAR+CHECK pattern as
  // `crawl_jobs.status` (DECISIONS.md §6/§17), not a native enum.
  status         String @default("queued") @db.VarChar(20)
  total_jobs     Int    @default(0)
  completed_jobs Int    @default(0)
  failed_jobs    Int    @default(0)
  // The four formula v1.0 components, stored individually (not just the
  // composite) so `GET /ai-runs/:id/score` can return a breakdown that
  // provably sums to `ai_visibility_score` under the stated weights — the
  // epic's evidence-traceability requirement — without recomputing
  // anything from raw observations on every read.
  mention_score        Decimal? @db.Decimal(6, 4)
  recommendation_score Decimal? @db.Decimal(6, 4)
  position_score       Decimal? @db.Decimal(6, 4)
  coverage_score       Decimal? @db.Decimal(6, 4)
  ai_visibility_score  Decimal? @db.Decimal(6, 4)
  // Stamped once AGGREGATE computes a score (docs/11-geo/GEO_ENGINE.md:
  // "changes to formula require version increment ..."). Every score this
  // epic ever produces carries the exact version that computed it.
  scoring_formula_version String? @db.VarChar(10)
  error        String?
  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  created_by   String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands             brands               @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Restrict: a query_set is never hard-deleted (archive is a status flag,
  // not a delete — see DECISIONS.md §16), so this is a defense-in-depth
  // default, same reasoning as every other non-composition FK in this
  // schema (DECISIONS.md §5).
  query_sets         query_sets           @relation(fields: [query_set_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user    users                @relation("ai_runs_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Restrict, same defense-in-depth default as every other non-composition
  // FK on this table (DECISIONS.md §5) — a competitor row is soft-deleted
  // (`deleted_at`), never hard-deleted, so the cascade case is not actually
  // reachable in practice, same caveat as the `query_sets` FK above.
  competitors        competitors?         @relation(fields: [competitor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ai_run_responses   ai_run_responses[]
  brand_observations brand_observations[]
  // Epic 14 (Measurement & Learning Loop) addition — set when a
  // measurement's "after" GEO component came from a fresh re-run of THIS
  // run (never the brand's normal, human-triggered `ai_runs` history).
  measurements       measurements[]

  @@index([organization_id], map: "idx_ai_runs_organization")
  @@index([brand_id], map: "idx_ai_runs_brand")
  @@index([query_set_id], map: "idx_ai_runs_query_set")
  @@index([status], map: "idx_ai_runs_status")
  // Epic 8 addition — `GET /brands/me/competitors/:competitorId/ai-runs`
  // and every competitive-gap/share-of-voice computation filter by exactly
  // this predicate (`brand_id` + `competitor_id`), same "every FK a query
  // actually filters by gets its own index" rule as every other index on
  // this table.
  @@index([competitor_id], map: "idx_ai_runs_competitor")
}

/// One (query x provider) execution within an `ai_runs` run — the
/// evidence-traceability boundary (ADR-004 / GEO_ENGINE.md "every score
/// must be explainable, click through to raw responses"). `raw_response`
/// is written the moment the GEO-query provider call itself succeeds,
/// BEFORE the separate extraction call is even attempted, and is never
/// touched again afterward — only `extraction_status`/`extraction_error`/
/// `extracted_at` change once extraction runs. This ordering is what makes
/// "evidence is never lost when extraction fails" true by construction:
/// the row committing this text to the database has already happened by
/// the time extraction (a second, independent provider call) can fail. See
/// `apps/api/src/lib/ai-visibility/pipeline.ts`.
model ai_run_responses {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  ai_run_id       String @db.Uuid
  query_id        String @db.Uuid
  provider        String @db.VarChar(50)
  model           String @db.VarChar(100)
  // ADR-006: required on every stored response, never null — the prompt
  // version that produced the GEO-query completion itself (not the
  // extraction prompt version, which lives on `brand_observations`).
  prompt_version String   @db.VarChar(50)
  temperature    Decimal? @db.Decimal(3, 2)
  raw_response   String
  // From `CompletionResult.requestId` (`@bebest/ai-provider`) — nullable
  // only because a provider mock in a test may omit it; a real provider
  // call always returns one.
  request_id        String? @db.VarChar(100)
  tokens_prompt     Int?
  tokens_completion Int?
  tokens_total      Int?
  latency_ms        Int?
  // pending | completed | failed — set by the separate extraction step
  // that reads this row's OWN `raw_response`. 'failed' means extraction
  // could not produce a schema-valid `BrandObservation` (see
  // `extraction_error`) — the raw evidence above is still fully intact and
  // readable via `GET /ai-runs/:id/responses`.
  extraction_status String    @default("pending") @db.VarChar(20)
  extraction_error  String?
  extracted_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  organizations      organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands             brands              @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Cascade: a response has zero independent meaning once its run is gone
  // — true composition child (DECISIONS.md §5), same rule as
  // `citations`/`mention_extractions -> ai_responses` for the legacy table.
  ai_runs            ai_runs             @relation(fields: [ai_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  queries            queries             @relation(fields: [query_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brand_observations brand_observations?

  @@index([ai_run_id], map: "idx_ai_run_responses_run")
  @@index([query_id], map: "idx_ai_run_responses_query")
  @@index([organization_id], map: "idx_ai_run_responses_organization")
}

/// The ADR-004 boundary: LLMs write this table, nothing else, and
/// deterministic formulas (never an LLM) read it to compute scores.
/// Extracted from exactly one `ai_run_responses.raw_response` —
/// `ai_run_response_id` is `@unique` (1:1) so a UI can always walk
/// score -> observation -> the single raw response it came from, per
/// GEO_ENGINE.md's evidence-trace example. No `created_by`/`updated_by`
/// and no `deleted_at`: AI-authored pipeline output, immutable once
/// written — same "deliberately not added" precedent as
/// `mention_extractions`/`citations` (DECISIONS.md §3/§4).
model brand_observations {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String @db.Uuid
  brand_id           String @db.Uuid
  ai_run_id          String @db.Uuid
  ai_run_response_id String @unique @db.Uuid
  query_id           String @db.Uuid

  brand_mentioned Boolean @default(false)
  // Normalized character-offset position of the first brand mention: 0 =
  // start of response (best), 1 = end. Null when not mentioned at all.
  // docs/12-ai/AI_ARCHITECTURE.md's `BrandObservation.brandFirstPosition`.
  brand_first_position Decimal? @db.Decimal(4, 3)
  brand_mention_count  Int      @default(0)
  // positive | neutral | negative | mixed
  brand_sentiment String? @db.VarChar(20)
  brand_context   String?
  brand_recommended Boolean @default(false)
  // strong | weak | implied
  brand_recommendation_strength String? @db.VarChar(20)

  competitors_mentioned String[] @default([])
  cited_urls             String[] @default([])
  cited_domains          String[] @default([])

  response_language   String? @db.VarChar(10)
  response_word_count Int?

  extraction_model_used     String @db.VarChar(100)
  extraction_prompt_version String @db.VarChar(50)
  // high | medium | low — reuses the Epic 2 `claim_confidence` enum
  // (identical 3-value vocabulary, see `brand_claims`) rather than adding
  // a second enum with the same values (DECISIONS.md §6 precedent: don't
  // duplicate a closed vocabulary that already exists under a generic
  // enough name).
  extraction_confidence claim_confidence @default(medium)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  organizations    organizations    @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands           brands           @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ai_runs          ai_runs          @relation(fields: [ai_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_run_responses ai_run_responses @relation(fields: [ai_run_response_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  queries          queries          @relation(fields: [query_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([ai_run_id], map: "idx_brand_observations_run")
  @@index([query_id], map: "idx_brand_observations_query")
  @@index([organization_id], map: "idx_brand_observations_organization")
}

model questions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                @db.Uuid
  brand_id            String                @db.Uuid
  intent_id           String?               @db.Uuid
  content             String
  type                question_type?
  tags                String[]
  version             Int?                  @default(1)
  created_by          String                @db.Uuid
  updated_by          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  query_set_questions query_set_questions[] @ignore
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands              brands                @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user     users                 @relation("questions_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updated_by_user     users?                @relation("questions_updated_by", fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  intents             intents?              @relation(fields: [intent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  runs                runs[]

  @@index([brand_id], map: "idx_questions_brand")
  @@index([intent_id], map: "idx_questions_intent")
  @@index([type], map: "idx_questions_type")
}

/// Ignored by Prisma Client (composite key, no single unique id); RLS is
/// still enforced via raw SQL — see rls.sql.
model query_set_questions {
  organization_id String        @db.Uuid
  query_set_id    String        @db.Uuid
  question_id     String        @db.Uuid
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  query_sets      query_sets    @relation(fields: [query_set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions       questions     @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "idx_query_set_questions_question")
  @@ignore
}

// ============================================================================
// AI RUNS / RESPONSES (legacy "runs" pipeline — question -> run -> response -> analysis)
// ============================================================================

model runs {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String        @db.Uuid
  brand_id           String        @db.Uuid
  question_id        String        @db.Uuid
  model_id           String        @db.Uuid
  status             run_status
  started_at         DateTime?     @db.Timestamptz(6)
  completed_at       DateTime?     @db.Timestamptz(6)
  error_message      String?
  metadata           Json?
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  batch_id           String?       @db.Uuid
  prompt_template_id String?       @db.Uuid
  temperature        Decimal?      @db.Decimal(3, 2)
  responses          responses[]
  organizations      organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands             brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ai_models          ai_models     @relation(fields: [model_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  questions          questions     @relation(fields: [question_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([batch_id], map: "idx_runs_batch")
  @@index([model_id], map: "idx_runs_model")
  @@index([question_id], map: "idx_runs_question")
  @@index([status], map: "idx_runs_status")
}

model responses {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  run_id          String        @db.Uuid
  content         String
  tokens_input    Int?
  tokens_output   Int?
  duration_ms     Int?
  raw_response    Json?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  analyses        analyses[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  runs            runs          @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id], map: "idx_responses_run")
}

model analyses {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  response_id           String                  @db.Uuid
  brand_id              String                  @db.Uuid
  status                run_status
  started_at            DateTime?               @db.Timestamptz(6)
  completed_at          DateTime?               @db.Timestamptz(6)
  error_message         String?
  metadata              Json?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  pipeline_version      String?                 @db.VarChar(50)
  model_used            String?                 @db.VarChar(100)
  prompt_used           String?
  organizations         organizations           @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                brands                  @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  responses             responses               @relation(fields: [response_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  analysis_findings     analysis_findings[]
  category_associations category_associations[]
  competitor_mentions   competitor_mentions[]
  entities              entities[]
  mentions              mentions[]
  recommendations       recommendations[]

  @@index([brand_id], map: "idx_analyses_brand")
  @@index([response_id], map: "idx_analyses_response")
  @@index([status], map: "idx_analyses_status")
}

model analysis_findings {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  analysis_id     String        @db.Uuid
  finding_type    finding_type
  entity_name     String?       @db.VarChar(255)
  entity_type     String?       @db.VarChar(50)
  sentiment       sentiment?
  strength        String?       @db.VarChar(50)
  position        Int?
  total_positions Int?
  context         String?
  confidence      Decimal?      @db.Decimal(3, 2)
  metadata        Json?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  analyses        analyses      @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analysis_id], map: "idx_analysis_findings_analysis")
  @@index([finding_type], map: "idx_analysis_findings_type")
}

model entities {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  analysis_id     String        @db.Uuid
  name            String        @db.VarChar(255)
  type            String        @db.VarChar(50)
  normalized_name String?       @db.VarChar(255)
  confidence      Decimal?      @db.Decimal(3, 2)
  metadata        Json?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands          brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  analyses        analyses      @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analysis_id], map: "idx_entities_analysis")
  @@index([name], map: "idx_entities_name")
