// ============================================================================
// AI VISIBILITY ENGINE (current pipeline — prompt_run -> prompt_job -> ai_response)
// ============================================================================

model prompt_runs {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  brand_id              String                  @db.Uuid
  trigger               run_trigger             @default(manual)
  status                run_status              @default(queued)
  total_prompts         Int                     @default(0)
  completed_prompts     Int                     @default(0)
  error_message         String?
  started_at            DateTime?               @db.Timestamptz(6)
  completed_at          DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  competitor_visibility competitor_visibility[]
  prompt_jobs           prompt_jobs[]
  organizations         organizations           @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands                brands                  @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  share_of_voice        share_of_voice[]
  visibility_scores     visibility_scores[]

  @@index([brand_id], map: "idx_prompt_runs_brand")
  @@index([status], map: "idx_prompt_runs_status")
}

model prompt_jobs {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String            @db.Uuid
  brand_id         String            @db.Uuid
  run_id           String            @db.Uuid
  query_id         String            @db.Uuid
  provider_id      String?           @db.Uuid
  status           job_status        @default(queued)
  attempts         Int               @default(0) @db.SmallInt
  last_error       String?
  queued_at        DateTime          @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?         @db.Timestamptz(6)
  ai_responses     ai_responses[]
  organizations    organizations     @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands           brands            @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  org_ai_providers org_ai_providers? @relation(fields: [provider_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  buyer_journeys   buyer_journeys    @relation(fields: [query_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prompt_runs      prompt_runs       @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id], map: "idx_prompt_jobs_run")
  @@index([status], map: "idx_prompt_jobs_status")
}

model ai_responses {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                @db.Uuid
  brand_id            String                @db.Uuid
  prompt_job_id       String                @db.Uuid
  query_id            String                @db.Uuid
  provider_name       String                @db.VarChar(50)
  model               String                @db.VarChar(100)
  prompt_version      String?               @db.VarChar(20) // ADR-006: which versioned prompt produced this — required at the application layer
  prompt_text         String
  response_text       String
  tokens_in           Int                   @default(0)
  tokens_out          Int                   @default(0)
  latency_ms          Int?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands              brands                @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prompt_jobs         prompt_jobs           @relation(fields: [prompt_job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  buyer_journeys      buyer_journeys        @relation(fields: [query_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  citations           citations[]
  mention_extractions mention_extractions[]

  @@index([prompt_job_id], map: "idx_ai_responses_job")
  @@index([query_id], map: "idx_ai_responses_query")
  @@index([brand_id], map: "idx_ai_responses_brand")
}

model citations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  brand_id        String        @db.Uuid
  response_id     String        @db.Uuid
