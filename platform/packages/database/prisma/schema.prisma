// ============================================================================
// EPIC 12 — Agent Runner (GEO Agent / SEO Agent / Growth Agent)
// ============================================================================
// docs/epics/12-agents.md's domain model calls for `agent_runs`/`agent_events`
// — genuinely new tables, NOT the legacy `geo_agent_runs`/`seo_agent_runs`/
// `growth_agent_runs`/`geo_agent_actions`/`seo_agent_actions` immediately
// above (checked directly against schema.prisma before writing this, per
// this epic's own "always verify against schema.prisma directly" instruction
// — same collision-check discipline DECISIONS.md §16/§19/§20/§21/§22/§24
// each used for their own new tables). Those five legacy tables model THREE
// SEPARATE per-agent-type run tables keyed into the OLD, untouched pipeline
// (`geo_gaps`, the legacy `keywords`/`opportunities`, `content_briefs`) with
// no event log, no autonomy level, and no approval/rollback mechanics — a
// different, narrower shape for a different, untouched pipeline, left
// completely alone (same treatment DECISIONS.md gives every other "old
// table, new epic" collision). This epic's tables are ONE unified run table
// across all three agent types (`agent_name` discriminates), a genuinely
// append-only event log (the spec's own "trust differentiator" requirement
// — never a single mutable status field), and a dedicated pending-action
// table for Level 3's one-click-approval + 30-day-rollback mechanics, which
// nothing in the ported schema modeled at all. `agent_runs`/`agent_events`
// were confirmed UNCLAIMED names (unlike `opportunities`/`recommendations`/
// `ai_responses`, the bare names here were never taken by the ported
// schema), so no disambiguating prefix is needed.
model agent_runs {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid

  // geo_agent | seo_agent | growth_agent — VARCHAR+CHECK (see checks.sql),
  // same "closed-but-may-grow" treatment `crawl_jobs.status`/`ai_runs.status`
  // already use (DECISIONS.md §6), not a native enum, in case a later epic
  // (Content/Research/Competitor/Measurement agents, per
  // docs/13-agents/AGENT_ARCHITECTURE.md's full agent-type list) adds a
  // fourth value without a schema migration to widen a Postgres ENUM.
  agent_name    String @db.VarChar(50)
  agent_version String @db.VarChar(20)

  status String @default("queued") @db.VarChar(20) // queued | running | completed | failed — see checks.sql

  triggered_by String @db.VarChar(20) // user | schedule | event — see checks.sql
  // Required when triggered_by = 'user' (checks.sql enforces this — the
  // human who clicked "run" is the accountable actor, same "triggering is a
  // human action -> required attribution" rule DECISIONS.md §17/§19 give
  // `crawl_jobs.created_by`/`ai_runs.created_by`; nullable here rather than
  // a NOT NULL `created_by` column because a schedule/event trigger
  // genuinely has no human to attribute to).
  triggered_by_id String? @db.Uuid

  // 1 | 2 | 3 ONLY — Level 4 is hard-blocked in application code
  // (`lib/agents/autonomy.ts`'s `assertAutonomyLevelAllowed`, never
  // bypassable by any config value) AND at this column's own CHECK
  // constraint (checks.sql: `autonomy_level IN (1, 2, 3)`) as defense in
  // depth — two independent layers, matching this epic's own "hard-coded
  // rejection, not a half-wired feature" instruction for autonomy level 4.
  autonomy_level Int @default(1) @db.SmallInt

  steps_completed Int @default(0)
  total_steps     Int @default(0)
  tokens_used     Int @default(0)
  latency_ms      Int?

  // Free-form pointer to whichever row the run's "complete" event names as
  // its result (an opportunity, a recommendation, itself) — open, not FK'd
  // to any one table, same "polymorphic reference, no fixed target" pattern
  // `actions.source_id`/`opportunity_evidence.source_id` already use in this
  // schema (DECISIONS.md §6/§22) for exactly this "could point at more than
  // one kind of table" shape.
  result_id String? @db.Uuid
  error     String?

  started_at   DateTime? @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  // No created_by/updated_by/deleted_at: a "run" is pipeline output exactly
  // like `ai_runs`/`crawl_jobs` (DECISIONS.md §4's "pipeline table" rule) —
  // `triggered_by`/`triggered_by_id` above already carry the one piece of
  // human attribution this table needs.
  organizations      organizations           @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands             brands                  @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  triggered_by_user  users?                  @relation("agent_runs_triggered_by", fields: [triggered_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  agent_events       agent_events[]
  agent_pending_actions agent_pending_actions[]

  @@index([organization_id], map: "idx_agent_runs_org")
  @@index([brand_id, agent_name], map: "idx_agent_runs_brand_agent")
  @@index([brand_id, created_at(sort: Desc)], map: "idx_agent_runs_brand_created")
  @@index([status], map: "idx_agent_runs_status")
}

// Append-only event log — genuinely never UPDATEd or DELETEd by application
// code (no `updated_at`/`deleted_at` at all, unlike almost every other table
// in this schema) — this IS the literal mechanism behind
// AGENT_ARCHITECTURE.md's "customers can see what the agent did, step-by-
// step... a trust differentiator" requirement; a single mutable
// `agent_runs.status` column could never reconstruct that history.
model agent_events {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  agent_run_id    String @db.Uuid

  // progress | observation | recommendation | draft | action_required |
  // complete | error — the exact AgentEvent union from
  // docs/13-agents/AGENT_ARCHITECTURE.md, transcribed as a VARCHAR+CHECK
  // (see checks.sql) rather than a native enum for the same "may grow"
  // reasoning as `agent_runs.agent_name`.
  type    String @db.VarChar(20)
  message String

  step        Int?
  total_steps Int?

  // A real ID/link into the underlying engine's own data (an ai_run id, an
  // opportunity id, a recommendation id, a query id) — this epic's own
  // explicit requirement ("real evidence, not a vague string"). JSONB, not a
  // bare UUID column, because the SHAPE of "evidence" differs per event type
  // (sometimes one id, sometimes a small set — e.g. the competitor ids a gap
  // finding names) — same "open, extensible" reasoning
  // `opportunity_evidence.raw_data` already uses for exactly this kind of
  // per-row-varying payload (DECISIONS.md §22).
  evidence Json?

  // The event-type-specific payload the interface's discriminated union
  // carries (`recommendation`, `content`, `action`, `resultId`/`summary`,
  // `fatal`) — stored once here rather than as a column per event type,
  // since only one branch of the union is ever populated per row.
  payload Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands        brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agent_runs    agent_runs    @relation(fields: [agent_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_pending_actions agent_pending_actions[]

  @@index([agent_run_id, created_at], map: "idx_agent_events_run_created")
  @@index([organization_id], map: "idx_agent_events_org")
}

// Level 3 ("Approve & Execute") mechanics: a one-click-approvable pending
// action plus its 30-day rollback window. This epic's spec is explicit that
// EXECUTION itself is Epic 13's job — this table stops at `approved`, it
// never flips to any kind of "executed" state, and nothing in this epic's
// code ever reads this table to actually publish/change anything.
model agent_pending_actions {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String @db.Uuid
  brand_id        String @db.Uuid
  agent_run_id    String @db.Uuid
  // The specific `action_required` event this row was created from — kept
  // so `GET /agent-runs/:id` can join a pending action back to the exact
  // evidence its originating event carried, without duplicating it here.
  agent_event_id String @db.Uuid

  // A real, checked tool name from the per-agent allowlist
  // (`lib/agents/tool-permissions.ts`) — e.g. `publish_content`,
  // `create_content_draft` — never a free-form string an approval route
  // could be tricked into accepting for a tool this agent was never granted.
  action_type String  @db.VarChar(50)
  title       String  @db.VarChar(500)
  description String?
  // The concrete thing being proposed (e.g. the recommendation id and its
  // action_type) — open JSONB, same "payload shape varies per action_type"
  // reasoning as `agent_events.payload` above.
  payload Json @default("{}")

  status String @default("pending") @db.VarChar(20) // pending | approved | rejected — see checks.sql

  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)
  // Set to `approved_at` + 30 days at the moment of approval — the spec's
  // literal "rollback available for 30 days" as a real, queryable deadline
  // rather than a comment; Epic 13 (the actual execute/rollback
  // implementation) reads this column, this epic only ever writes it.
  rollback_until DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brands            brands        @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agent_runs        agent_runs    @relation(fields: [agent_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_events      agent_events  @relation(fields: [agent_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approved_by_user  users?        @relation("agent_pending_actions_approved_by", fields: [approved_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Epic 13 (Action Center & Controlled Publishing) addition — the real FK
  // Epic 12 -> Epic 13 handoff: a Level-3 pending action, once approved at
  // THIS table's own layer, becomes AT MOST one pending `actions` row
  // (`actions.agent_pending_action_id` is `@unique`). See
  // routes/agent-run-details.ts's approve handler.
  actions           actions?

  @@index([agent_run_id], map: "idx_agent_pending_actions_run")
  @@index([organization_id, status], map: "idx_agent_pending_actions_org_status")
}

