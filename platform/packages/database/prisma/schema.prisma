  geo_gap_score      Decimal             @default(0) @db.Decimal(5, 2)
  unified_score      Decimal             @default(0) @db.Decimal(5, 2)
  volume             Int?
  difficulty         Int?                @db.SmallInt
  priority_tier      priority_tier       @default(P3)
